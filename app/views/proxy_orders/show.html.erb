<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Back Link -->
  <div class="mb-6">
    <%= link_to t("proxy_orders.show.back_to_dashboard"), root_path, class: "text-accent hover:text-accent-hover font-bold text-sm" %>
  </div>

  <!-- Header -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
    <p class="text-stone-600"><%= l(@event.event_date, format: :short) %></p>
  </div>

  <!-- Status Display -->
  <div id="proxy_order_status" class="flex items-center gap-4 mb-8">
    <span data-status="ordered" class="px-4 py-2 rounded-md text-sm <%= @proxy_order.ordered? ? 'bg-indigo-700 text-white font-bold' : 'bg-white border border-stone-200 text-stone-600' %>">
      <%= t("activerecord.enums.proxy_order.status.ordered") %>
    </span>
    <span class="text-stone-400">→</span>
    <span data-status="arrived" class="px-4 py-2 rounded-md text-sm <%= @proxy_order.arrived? ? 'bg-indigo-700 text-white font-bold' : 'bg-white border border-stone-200 text-stone-600' %>">
      <%= t("activerecord.enums.proxy_order.status.arrived") %>
    </span>
    <span class="text-stone-400">→</span>
    <span data-status="completed" class="px-4 py-2 rounded-md text-sm <%= @proxy_order.completed? ? 'bg-indigo-700 text-white font-bold' : 'bg-white border border-stone-200 text-stone-600' %>">
      <%= t("activerecord.enums.proxy_order.status.completed") %>
    </span>
  </div>

  <!-- Provisional Notice -->
  <% if @proxy_order.ordered? %>
    <div id="proxy_order_provisional" class="bg-accent-soft border border-border rounded-lg p-4 mb-6 text-sm text-stone-700">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-accent-soft text-accent mr-2"><%= t("proxy_orders.show.provisional") %></span>
      <%= t("proxy_orders.show.provisional_notice") %>
    </div>
  <% end %>

  <!-- My Items Table -->
  <div class="mb-8">
    <h2 class="text-xl font-bold text-stone-800 mb-4"><%= t("proxy_orders.show.my_items") %></h2>

    <% if @allocations.any? %>
      <div class="overflow-x-auto">
        <table id="proxy_order_my_items" class="w-full bg-white border border-stone-200 rounded-[10px] text-sm">
          <thead class="bg-stone-100 border-b border-stone-200">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.card_name") %></th>
              <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.expansion") %></th>
              <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.foil") %></th>
              <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.frame") %></th>
              <th class="px-4 py-3 text-center text-xs font-bold text-stone-500"><%= t("proxy_orders.show.quantity") %></th>
              <th class="px-4 py-3 text-center text-xs font-bold text-stone-500"><%= t("proxy_orders.show.lost") %></th>
              <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.unit_price") %></th>
              <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.subtotal") %></th>
            </tr>
          </thead>
          <tbody>
            <% @allocations.each do |allocation| %>
              <tr id="<%= dom_id(allocation) %>" class="border-t border-stone-200">
                <td class="px-4 py-3"><%= allocation.proxy_order_item.card_name %></td>
                <td class="px-4 py-3"><%= allocation.proxy_order_item.expansion&.name %></td>
                <td class="px-4 py-3"><%= t("activerecord.enums.trade_card_offer.foil.#{allocation.proxy_order_item.foil}") %></td>
                <td class="px-4 py-3"><%= t("activerecord.enums.trade_card_offer.frame.#{allocation.proxy_order_item.frame}") %></td>
                <td class="px-4 py-3 text-center"><%= allocation.quantity %></td>
                <td class="px-4 py-3 text-center"><%= allocation.lost_quantity %></td>
                <td class="px-4 py-3 text-right"><%= usd(@calculator.unit_price(allocation.proxy_order_item)) %></td>
                <td class="px-4 py-3 text-right"><%= usd(@calculator.subtotal(allocation)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-stone-600 bg-white border border-stone-200 rounded-[10px] p-4">
        <%= t("proxy_orders.show.no_items") %>
      </p>
    <% end %>
  </div>

  <!-- Payment Summary -->
  <div id="proxy_order_my_payment" class="space-y-4 max-w-md">
    <div class="bg-white border border-stone-200 rounded-[10px] p-6">
      <h2 class="text-xl font-bold text-stone-800 mb-4"><%= t("proxy_orders.show.my_payment") %></h2>

      <div class="space-y-3 mb-4 pb-4 border-b border-stone-200">
        <div class="flex justify-between text-sm">
          <span><%= t("admin.proxy_order.total_fees") %></span>
          <span><%= usd(@calculator.fee_total) %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span><%= t("admin.proxy_order.fee_per_person") %></span>
          <span><%= usd(@calculator.fee_per_person) %></span>
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex justify-between">
          <span data-role="goods-total"><%= t("admin.proxy_order.goods_total") %></span>
          <span><%= usd(@calculator.goods_total(@participant)) %></span>
        </div>
        <div class="flex justify-between">
          <span data-role="fee"><%= t("admin.proxy_order.fee") %></span>
          <span><%= usd(@calculator.fee_for(@participant)) %></span>
        </div>
        <div class="flex justify-between font-bold">
          <span><%= t("admin.proxy_order.payment_usd") %></span>
          <span data-role="payment-usd"><%= usd(@calculator.payment_usd(@participant)) %></span>
        </div>
        <div class="flex justify-between font-bold items-center">
          <div class="flex items-center gap-2">
            <span><%= t("admin.proxy_order.payment_jpy") %></span>
            <% if @proxy_order.ordered? %>
              <span class="inline-block px-2 py-0.5 rounded-full text-xs font-bold bg-accent-soft text-accent"><%= t("proxy_orders.show.provisional") %></span>
            <% end %>
          </div>
          <span data-role="payment-jpy"><%= jpy_or_pending(@calculator.payment_jpy(@participant)) %></span>
        </div>

        <% if @proxy_order.arrived? || @proxy_order.completed? %>
          <div class="pt-4 border-t border-stone-200 mt-4">
            <div class="flex justify-between text-sm">
              <span>
                <% if @participant.handed_over_at? %>
                  <%= t("admin.proxy_order.handed_over") %>
                <% else %>
                  <%= t("admin.proxy_order.not_handed_over") %>
                <% end %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
