<nav class="flex gap-6 border-b border-stone-200 mb-6" aria-label="<%= t("histories.tabs.label") %>">
  <%= link_to t("histories.tabs.trades"), histories_path,
      class: "pb-3 -mb-px border-b-2 text-sm font-semibold #{if current == :trades then 'border-accent text-accent' else 'border-transparent text-stone-500 hover:text-stone-800' end}",
      aria: { current: current == :trades ? "page" : nil } %>
  <%= link_to t("histories.tabs.proxy_orders"), proxy_order_histories_path,
      class: "pb-3 -mb-px border-b-2 text-sm font-semibold #{if current == :proxy_orders then 'border-accent text-accent' else 'border-transparent text-stone-500 hover:text-stone-800' end}",
      aria: { current: current == :proxy_orders ? "page" : nil } %>
</nav>
