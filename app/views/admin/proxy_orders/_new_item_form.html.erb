<div id="new_proxy_order_item" class="bg-white border border-stone-200 rounded-lg">
  <div class="p-6">
    <h2 class="text-lg font-bold text-stone-800 mb-4"><%= t("admin.proxy_order.add_card_block") %></h2>

    <%= form_with model: @proxy_order.proxy_order_items.build, url: admin_event_proxy_order_items_path(@event), id: "new_proxy_order_item_form", local: true do |f| %>
      <% if @proxy_order.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
          <ul class="list-disc list-inside space-y-1 text-red-700 text-sm">
            <% @proxy_order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :card_name, class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.text_field :card_name, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>

      <div class="mb-4 relative" data-controller="expansion-select">
        <label class="block text-xs font-bold text-stone-500 mb-1" for="new_proxy_order_item_expansion_input"><%= t("activerecord.attributes.proxy_order_item.expansion_id") %></label>
        <input type="text" id="new_proxy_order_item_expansion_input" autocomplete="off"
               data-expansion-select-target="input"
               data-action="keyup->expansion-select#search blur->expansion-select#hideDropdown change->expansion-select#stopChange"
               placeholder="<%= t("admin.proxy_order.expansion_placeholder") %>"
               class="w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent">
        <%= f.hidden_field :expansion_id, data: { "expansion-select-target": "select" } %>
        <turbo-frame id="new_proxy_order_item_expansion_suggestions" data-expansion-select-target="frame" class="absolute w-full mt-1 bg-white border border-stone-300 rounded-md shadow-lg z-10" style="display: none;"></turbo-frame>
      </div>

      <div class="mb-4">
        <%= f.label :foil, class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.select :foil, ProxyOrderItem.foils.keys.map { |k| [t("activerecord.enums.trade_card_offer.foil.#{k}"), k] }, { selected: "non_foil" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>

      <div class="mb-6">
        <%= f.label :frame, class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.select :frame, ProxyOrderItem.frames.keys.map { |k| [t("activerecord.enums.trade_card_offer.frame.#{k}"), k] }, { selected: "normal" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>

      <%= f.submit t("admin.proxy_order.add_card_block"), class: "bg-offer text-white px-4 py-2 rounded-md hover:opacity-90 font-bold text-xs cursor-pointer" %>
    <% end %>
  </div>
</div>
