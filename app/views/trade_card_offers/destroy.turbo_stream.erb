<%= turbo_stream.remove dom_id(@trade_card_offer, :group) %>

<%= turbo_stream.replace "offers_list" do %>
  <%= render(partial: "trade_card_offers/list", locals: { list: @offers_list, sync_url: true }, formats: [:html]) %>
<% end %>

<%= turbo_stream.replace "wants_list" do %>
  <%= render(partial: "trade_card_wants/list", locals: { list: @wants_list, sync_url: false }, formats: [:html]) %>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.destroy', card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
