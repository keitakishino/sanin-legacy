<turbo-stream action="remove" target="<%= dom_id(@trade_card_want) %>">
</turbo-stream>

<turbo-stream action="replace" target="trade_aggregates">
  <template><%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_want.trade }, formats: [:html]) %></template>
</turbo-stream>

<turbo-stream action="append" target="toast-container">
  <template><%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_want.destroy', card_name: @trade_card_want.card_name) }, formats: [:html]) %></template>
</turbo-stream>
