<% if @trade_card_want.persisted? %>
  <% frame_id = dom_id(@trade_card_want, :edit_form) %>
<% else %>
  <% admin_context = @trade_id.present? %>
  <% frame_id = admin_context ? 'new_trade_card_want_admin' : 'new_trade_card_want' %>
<% end %>

<turbo-stream action="replace" target="<%= frame_id %>">
  <template>
    <turbo-frame id="<%= frame_id %>" class="mt-4 border-t pt-4">
      <%= render(partial: 'form', locals: { trade_card_want: @trade_card_want, frame_id: frame_id }, formats: [:html]) %>
    </turbo-frame>
  </template>
</turbo-stream>

<% if @trade_card_want.errors.any? %>
  <turbo-stream action="append" target="toast-container">
    <template><%= render(partial: "shared/toast", locals: { message: @trade_card_want.errors.full_messages.join(", "), variant: :danger }, formats: [:html]) %></template>
  </turbo-stream>
<% end %>
