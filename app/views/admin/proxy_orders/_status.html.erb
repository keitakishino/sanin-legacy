<div id="proxy_order_status" class="flex items-center gap-4 mb-8">
  <span data-status="ordered" class="px-4 py-2 rounded <%= 'bg-primary text-primary-content font-bold' if @proxy_order.status == 'ordered' %>">
    <%= t("activerecord.enums.proxy_order.status.ordered") %>
  </span>
  <span class="text-gray-400">→</span>
  <span data-status="arrived" class="px-4 py-2 rounded <%= 'bg-primary text-primary-content font-bold' if @proxy_order.status == 'arrived' %>">
    <%= t("activerecord.enums.proxy_order.status.arrived") %>
  </span>
  <span class="text-gray-400">→</span>
  <span data-status="completed" class="px-4 py-2 rounded <%= 'bg-primary text-primary-content font-bold' if @proxy_order.status == 'completed' %>">
    <%= t("activerecord.enums.proxy_order.status.completed") %>
  </span>

  <div class="ml-auto flex gap-2">
    <% if @proxy_order.ordered? %>
      <%= button_to t("admin.proxy_order.to_arrived"), admin_event_proxy_order_path(@event), method: :patch, params: { proxy_order: { status: "arrived" } }, class: "btn btn-sm btn-primary" %>
    <% elsif @proxy_order.arrived? %>
      <%= button_to t("admin.proxy_order.to_completed"), admin_event_proxy_order_path(@event), method: :patch, params: { proxy_order: { status: "completed" } }, class: "btn btn-sm btn-primary" %>
      <%= button_to t("admin.proxy_order.back_to_ordered"), admin_event_proxy_order_path(@event), method: :patch, params: { proxy_order: { status: "ordered" } }, data: { turbo_confirm: t("admin.proxy_order.back_to_ordered") + "しますか？" }, class: "btn btn-sm btn-secondary" %>
    <% elsif @proxy_order.completed? %>
      <%= button_to t("admin.proxy_order.back_to_arrived"), admin_event_proxy_order_path(@event), method: :patch, params: { proxy_order: { status: "arrived" } }, data: { turbo_confirm: t("admin.proxy_order.back_to_arrived") + "しますか？" }, class: "btn btn-sm btn-secondary" %>
    <% end %>
  </div>
</div>

<% if @transition_errors.present? %>
  <div id="proxy_order_status_errors" class="alert alert-error mb-4">
    <ul>
      <% @transition_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>
