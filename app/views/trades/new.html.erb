<%= form_with model: @trade do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :contact %>
    <%= form.collection_radio_buttons :contact, Trade.contacts, :last, :first %>
  </div>

  <div>
    <%= form.label :contact_account %>
    <%= form.text_field :contact_account %>
  </div>

  <div>
    <%= form.label :residue %>
    <%= form.collection_radio_buttons :residue, Trade.residues, :last, :first %>
  </div>

  <div>
    <%= form.label :memo %>
    <%= form.textarea :memo %>
  </div>

  <div>
    <%= form.fields_for :trade_cards do |card| %>
      <div>
        <%= card.label :name %>
        <%= card.text_field :name %>
      </div>

      <div>
        <%= card.label :expansion %>
        <%= card.text_field :expansion %>
      </div>

      <div>
        <%= card.label :foil %>
        <%= card.checkbox :foil %>
      </div>

      <div>
        <%= form.label :language %>
        <%= form.collection_select :language, TradeCard.languages, :last, :first %>
      </div>

      <div>
        <%= form.label :edition %>
        <%= form.collection_select :edition, TradeCard.editions, :last, :first %>
      </div>

      <div>
        <%= form.label :state %>
        <%= form.collection_select :state, TradeCard.states, :last, :first %>
      </div>
    <% end %>
  </div>

  <%= form.submit %>
<% end %>
