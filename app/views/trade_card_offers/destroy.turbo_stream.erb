<%= turbo_stream.remove dom_id(@trade_card_offer) %>

<% if @trade_card_offer.trade.trade_card_offers.count == 0 %>
  <% admin_context = @trade_id.present? %>
  <% empty_classes = admin_context ? 'text-stone-500 text-center py-8' : 'text-stone-400 text-center py-8 text-xs' %>
  <%= turbo_stream.append "trade_card_offers" do %>
    <p id="trade_card_offers_empty" class="<%= empty_classes %>">カード明細はまだありません</p>
  <% end %>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.destroy', card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
