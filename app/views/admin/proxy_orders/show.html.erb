<div class="bg-stone-50 py-8">
  <div class="mb-4">
    <%= link_to "← 戻る", admin_events_path, class: "text-indigo-700 hover:text-indigo-800 font-medium text-sm" %>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-stone-800"><%= @event.title %></h1>
    <p class="text-stone-600"><%= l(@event.event_date, format: :short) %></p>
  </div>

  <%= render "status" %>

  <div class="md:grid md:grid-cols-[minmax(0,1fr)_20rem] md:gap-6">
    <div>
      <%= render "fees" %>
      <%= render "items" %>
      <% if @proxy_order.details_editable? %>
        <%= render "new_item_form" %>
      <% end %>
      <%= render "participants" %>
    </div>

    <aside class="md:sticky md:top-4 md:self-start md:max-h-[calc(100vh-2rem)] md:overflow-y-auto">
      <%= render "summary" %>
    </aside>
  </div>
</div>
