# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# =========================================
# Production Secrets (destination: none / plain `kamal deploy`)
# =========================================

# Rails Master Key
# Extracted from config/master.key (never commit this file to git!)
# This key is used to decrypt config/credentials.yml.enc
# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)

# Database Credentials
# DATABASE_HOST is the Kamal accessory's container name (not a secret), fixed per destination.
# The other values should come from environment variables set by your deployment system (.env.production).
DATABASE_PASSWORD=$DATABASE_PASSWORD
DATABASE_HOST=sanin_legacy-db
DATABASE_USER=$DATABASE_USER
DATABASE_PORT=$DATABASE_PORT

# Docker Registry Credentials
# Provide your Docker Hub access token for image registry authentication.
# Alternative: Configure via Rails credentials or password manager.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# OAuth Credentials (Google)
# These are required for Google OAuth 2.0 authentication in production.
# Obtain these from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=$GOOGLE_OAUTH_CLIENT_SECRET

# OAuth Credentials (Twitter/X)
# These are required for Twitter OAuth 1.0a authentication in production.
# Obtain these from Twitter Developer Portal.
TWITTER_OAUTH_API_KEY=$TWITTER_OAUTH_API_KEY
TWITTER_OAUTH_API_SECRET=$TWITTER_OAUTH_API_SECRET
