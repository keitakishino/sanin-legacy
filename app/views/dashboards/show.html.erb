<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= t("dashboards.show.title") %></h1>
    <p class="text-gray-600 text-sm">
      <%= t("dashboards.show.subtitle") %>
    </p>
  </div>

  <!-- Incomplete Trades Section with Turbo Frame (Lazy Loading) -->
  <turbo-frame id="incomplete_trades" src="<%= dashboards_incomplete_trades_path %>" loading="lazy"></turbo-frame>

  <!-- Navigation -->
  <div class="mt-8 pt-8 border-t border-gray-200">
    <%= link_to t("dashboards.show.view_events"), events_path,
        class: "text-blue-600 hover:text-blue-800 font-semibold" %>
  </div>
</div>
