<turbo-frame id="incomplete_trades">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-stone-800 mb-6"><%= t("dashboards.show.incomplete_trades_title") %></h2>

    <% if @incomplete_trades.any? %>
      <div class="space-y-4">
        <% @incomplete_trades.each do |trade| %>
          <div class="bg-white border border-stone-200 rounded-[10px] p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <!-- Event and Trade Info -->
                <p class="text-lg font-bold text-stone-800 mb-2">
                  <%= trade.event.title %>
                </p>
                <p class="text-xs text-stone-500 mb-4">
                  <%= t("dashboards.show.event_date_label") %>: <%= trade.event.event_date.strftime("%Y年%m月%d日") %>
                </p>

                <!-- Status Badge -->
                <div class="mb-4">
                  <% case trade.status
                     when "pending"
                       badge_bg = "bg-neutral-soft"
                       badge_text = "text-stone-500"
                     when "in_progress"
                       badge_bg = "bg-warning-soft"
                       badge_text = "text-warning"
                     when "completed"
                       badge_bg = "bg-success-soft"
                       badge_text = "text-success"
                     when "cancelled"
                       badge_bg = "bg-danger-soft"
                       badge_text = "text-danger"
                     else
                       badge_bg = "bg-neutral-soft"
                       badge_text = "text-stone-500"
                     end %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-bold <%= badge_bg %> <%= badge_text %>">
                    <%= I18n.t("activerecord.enums.trade.status.#{trade.status}") %>
                  </span>
                </div>

                <!-- Card Name Chips -->
                <div class="space-y-3">
                  <!-- Offer Cards -->
                  <div class="flex flex-wrap gap-2 items-center">
                    <span class="text-xs font-bold text-stone-500 mr-2">出すカード:</span>
                    <% offers_limited = trade.trade_card_offers.limit(5) %>
                    <% offers_total = trade.trade_card_offers.count %>
                    <% offers_limited.each do |offer| %>
                      <div class="inline-flex items-center gap-2 bg-offer-soft text-offer-text px-3 py-1.5 rounded-md text-xs font-semibold">
                        <div class="w-2 h-2 bg-offer rounded-sm flex-shrink-0"></div>
                        <%= offer.card_name %>
                      </div>
                    <% end %>
                    <% if offers_total > 5 %>
                      <div class="inline-flex items-center bg-neutral-soft text-stone-500 px-3 py-1.5 rounded-md text-xs font-semibold">
                        +<%= offers_total - 5 %>件
                      </div>
                    <% end %>
                  </div>

                  <!-- Want Cards -->
                  <div class="flex flex-wrap gap-2 items-center">
                    <span class="text-xs font-bold text-stone-500 mr-2">欲しいカード:</span>
                    <% wants_limited = trade.trade_card_wants.limit(5) %>
                    <% wants_total = trade.trade_card_wants.count %>
                    <% wants_limited.each do |want| %>
                      <div class="inline-flex items-center gap-2 bg-want-soft text-want-text px-3 py-1.5 rounded-md text-xs font-semibold">
                        <div class="w-2 h-2 bg-want rounded-full flex-shrink-0"></div>
                        <%= want.card_name %>
                      </div>
                    <% end %>
                    <% if wants_total > 5 %>
                      <div class="inline-flex items-center bg-neutral-soft text-stone-500 px-3 py-1.5 rounded-md text-xs font-semibold">
                        +<%= wants_total - 5 %>件
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Action Link -->
              <div class="ml-4">
                <%= link_to t("dashboards.show.view_details"), trade_path(trade.event_id),
                    class: "px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs whitespace-nowrap",
                    data: { turbo_frame: "_top" } %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-stone-50 rounded-lg p-8 text-center">
        <p class="text-stone-500 text-lg mb-4"><%= t("dashboards.show.no_trades_message") %></p>
        <p class="text-stone-500 text-sm mb-6">
          <%= t("dashboards.show.no_trades_guidance") %>
        </p>
        <%= link_to t("dashboards.show.view_events"), events_path,
            class: "text-accent hover:text-accent-hover font-bold text-sm",
            data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>
</turbo-frame>
