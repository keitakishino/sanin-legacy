<%= turbo_stream.replace dom_id(@trade_card_offer) do %>
  <%= render 'trade_card_offer', trade_card_offer: @trade_card_offer %>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.update', card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
