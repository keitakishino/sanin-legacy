<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Admin context detection -->
  <% admin_context = current_user.role_admin? && params[:trade_id].present? %>

  <!-- Header -->
  <div class="mb-8">
    <%= link_to "← イベント一覧に戻る", events_path, class: "text-accent hover:text-accent-hover mb-4 inline-block font-bold text-sm" %>
    <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
    <p class="text-stone-500 text-xs">
      開催日: <%= @event.event_date.strftime("%Y年%m月%d日") %>
    </p>
  </div>

  <!-- Trade Status -->
  <div class="bg-neutral-soft border border-stone-200 rounded-lg p-4 mb-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-sm font-bold text-stone-800">トレード状態</h2>
        <p class="text-stone-500 text-xs mt-1">
          <%= I18n.t("activerecord.enums.trade.status.#{@trade.status}") %>
        </p>
      </div>
    </div>

    <!-- Aggregated Amounts Section (embedded in card) -->
    <%= render "aggregates_inline", trade: @trade %>
  </div>

  <!-- Card Offers Section -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-stone-800">出すカード一覧</h2>
    </div>

    <div class="overflow-x-auto border border-stone-200 rounded-lg">
      <table class="w-full">
        <thead class="bg-stone-100">
          <tr>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500">数量</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">言語</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">状態</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">フォイル</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">フレーム</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">PWマーク</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">セット</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">備考</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">金額</th>
            <th class="md:hidden px-4 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-4 py-3 text-right text-xs font-bold text-stone-500">操作</th>
          </tr>
        </thead>
        <tbody id="trade_card_offers">
          <% if @trade.trade_card_offers.any? %>
            <% @trade.trade_card_offers.each do |offer| %>
              <%= render offer %>
            <% end %>
          <% else %>
            <tr id="trade_card_offers_empty">
              <td colspan="12" class="px-4 py-8 text-center text-stone-400 text-xs">カード明細はまだありません</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <button
        type="button"
        class="px-4 py-2 bg-offer text-white rounded-md hover:opacity-90 font-bold text-xs"
        id="add_offer_btn">
        カード明細を追加
      </button>
    </div>

    <% offer_frame_id = admin_context ? 'new_trade_card_offer_admin' : 'new_trade_card_offer' %>
    <turbo-frame id="<%= offer_frame_id %>" style="display: none;" class="mt-4 bg-stone-50 p-4 rounded-lg" data-controller="form-reset">
      <%= render 'trade_card_offers/form', trade_card_offer: @trade.trade_card_offers.build, frame_id: offer_frame_id %>
    </turbo-frame>
  </div>

  <!-- Card Wants Section -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-stone-800">欲しいカード一覧</h2>
    </div>

    <div class="overflow-x-auto border border-stone-200 rounded-lg">
      <table class="w-full">
        <thead class="bg-stone-100">
          <tr>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500">数量</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">言語</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">状態</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">フォイル</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">フレーム</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">セット</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">備考</th>
            <th class="hidden md:table-cell px-4 py-3 text-left text-xs font-bold text-stone-500">金額</th>
            <th class="md:hidden px-4 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-4 py-3 text-right text-xs font-bold text-stone-500">操作</th>
          </tr>
        </thead>
        <tbody id="trade_card_wants">
          <% if @trade.trade_card_wants.any? %>
            <% @trade.trade_card_wants.each do |want| %>
              <%= render want %>
            <% end %>
          <% else %>
            <tr id="trade_card_wants_empty">
              <td colspan="11" class="px-4 py-8 text-center text-stone-400 text-xs">カード明細はまだありません</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <button
        type="button"
        class="px-4 py-2 bg-want text-white rounded-md hover:opacity-90 font-bold text-xs"
        id="add_want_btn">
        カード明細を追加
      </button>
    </div>

    <% want_frame_id = admin_context ? 'new_trade_card_want_admin' : 'new_trade_card_want' %>
    <turbo-frame id="<%= want_frame_id %>" style="display: none;" class="mt-4 bg-stone-50 p-4 rounded-lg" data-controller="form-reset">
      <%= render 'trade_card_wants/form', trade_card_want: @trade.trade_card_wants.build, frame_id: want_frame_id %>
    </turbo-frame>
  </div>

  <script>
    // Toggle add form buttons
    document.getElementById('add_offer_btn').addEventListener('click', function() {
      const frame = document.getElementById('<%= offer_frame_id %>');
      frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('add_want_btn').addEventListener('click', function() {
      const frame = document.getElementById('<%= want_frame_id %>');
      frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
    });

    // Mobile accordion expansion
    document.querySelectorAll('[data-toggle-expand]').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const rowId = this.getAttribute('data-toggle-expand');
        const expandRow = document.getElementById('expand_' + rowId);
        const editFormRow = document.getElementById('edit_form_' + rowId);

        if (expandRow) {
          const isHidden = expandRow.style.display === 'none';
          // Close all other expand rows and edit forms in the same table
          const table = this.closest('table');
          table.querySelectorAll('[id^="expand_"]').forEach(row => {
            row.style.display = 'none';
          });
          table.querySelectorAll('[id^="edit_form_"]').forEach(row => {
            row.style.display = 'none';
          });
          table.querySelectorAll('[data-toggle-expand]').forEach(btn => {
            btn.setAttribute('aria-expanded', 'false');
          });

          // Toggle this row
          if (isHidden) {
            expandRow.style.display = 'table-row';
            this.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });

    // Listen for Turbo updates to re-bind accordion buttons
    document.addEventListener('turbo:load', function() {
      document.querySelectorAll('[data-toggle-expand]').forEach(button => {
        // Remove old listeners by cloning
        const newButton = button.cloneNode(true);
        button.parentNode.replaceChild(newButton, button);

        newButton.addEventListener('click', function(e) {
          e.preventDefault();
          const rowId = this.getAttribute('data-toggle-expand');
          const expandRow = document.getElementById('expand_' + rowId);

          if (expandRow) {
            const isHidden = expandRow.style.display === 'none';
            const table = this.closest('table');
            table.querySelectorAll('[id^="expand_"]').forEach(row => {
              row.style.display = 'none';
            });
            table.querySelectorAll('[id^="edit_form_"]').forEach(row => {
              row.style.display = 'none';
            });
            table.querySelectorAll('[data-toggle-expand]').forEach(btn => {
              btn.setAttribute('aria-expanded', 'false');
            });

            if (isHidden) {
              expandRow.style.display = 'table-row';
              this.setAttribute('aria-expanded', 'true');
            }
          }
        });
      });
    });

    // Hide expand buttons on desktop
    function updateExpandButtonVisibility() {
      const buttons = document.querySelectorAll('[data-toggle-expand]');
      const isDesktop = window.innerWidth >= 768;
      buttons.forEach(btn => {
        btn.style.display = isDesktop ? 'none' : 'inline-block';
      });
    }
    updateExpandButtonVisibility();
    window.addEventListener('resize', updateExpandButtonVisibility);
  </script>
</div>
