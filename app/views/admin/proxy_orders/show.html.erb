<div class="bg-stone-50 min-h-screen">
  <main class="px-4 py-8 flex flex-col gap-8">
    <div class="flex flex-wrap justify-between items-start gap-4">
      <div>
        <%= link_to t("admin.proxy_order.back_to_events"), admin_events_path, class: "inline-block mb-4 text-accent hover:text-accent-hover font-bold text-sm" %>
        <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
        <p class="text-xs text-stone-500">
          <span class="inline-block px-[10px] py-0.5 rounded-full bg-accent-soft text-accent font-bold mr-2"><%= t("activerecord.attributes.event.event_types.proxy_order") %></span>
          <%= t("admin.proxy_order.event_date", date: l(@event.event_date.to_date, format: :long)) %>
        </p>
      </div>
      <%= render "status" %>
    </div>

    <%= render "fees" %>

    <div class="flex flex-col lg:flex-row gap-6 items-start">
      <section class="flex-1 min-w-0 flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-stone-800"><%= t("admin.proxy_order.card_details") %></h2>
        <%= render "item_list" %>
        <% if @proxy_order.details_editable? %>
          <%= render "new_item_form" %>
        <% end %>
      </section>

      <aside class="w-full lg:w-80 lg:flex-none lg:sticky lg:top-4 lg:self-start lg:max-h-[calc(100vh-2rem)] lg:overflow-y-auto">
        <%= render "summary" %>
      </aside>
    </div>
  </main>
</div>
