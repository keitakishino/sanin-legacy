<div class="bg-stone-50 min-h-screen flex items-center justify-center">
  <div class="bg-white border border-stone-200 rounded-lg p-8 max-w-xs w-full">
    <h2 class="text-2xl font-bold text-stone-800 mb-6">サインイン</h2>

    <%= form_with url: "/signin", local: true do |f| %>
      <div class="mb-4">
        <%= f.label :email, "メールアドレス", class: "block text-xs font-bold text-stone-500 mb-2" %>
        <%= f.email_field :email, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "パスワード", class: "block text-xs font-bold text-stone-500 mb-2" %>
        <%= f.password_field :password, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
      </div>

      <div class="mb-4">
        <%= f.submit "サインイン", class: "w-full bg-accent text-white px-4 py-2 rounded-md hover:bg-accent-hover font-bold text-xs" %>
      </div>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <%= link_to "初めてご利用の方は招待コードの入力へ", "/invite", class: "text-accent hover:text-accent-hover font-bold" %>
    </div>
  </div>
</div>
