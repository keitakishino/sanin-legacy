# Database (docker-compose environment)
DATABASE_HOST=db
DATABASE_USER=sanin_legacy
DATABASE_PASSWORD=development_password
DATABASE_PORT=5432

# Docker Compose Port Configuration
# デフォルト値を使用する場合はコメントアウトしたままにしてください
# worktree作成時に scripts/create_worktree.sh により自動設定されます
# DB_PORT=5432
# APP_PORT=3000

# Rails
RAILS_ENV=development

# OmniAuth (Google)
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# OmniAuth (Twitter/X)
TWITTER_OAUTH_API_KEY=your_api_key_here
TWITTER_OAUTH_API_SECRET=your_api_secret_here
