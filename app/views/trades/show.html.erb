<div class="w-full max-w-7xl mx-auto px-4 py-8">
  <!-- Admin context detection -->
  <% admin_context = current_user.role_admin? && params[:trade_id].present? %>
  <% can_create = @trade.card_detail_operation_allowed?(current_user, :create) %>

  <!-- Header -->
  <div class="mb-8">
    <%= link_to "← イベント一覧に戻る", events_path, class: "text-accent hover:text-accent-hover mb-4 inline-block font-bold text-sm" %>
    <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
    <p class="text-stone-500 text-xs">
      開催日: <%= @event.event_date.strftime("%Y年%m月%d日") %>
    </p>
  </div>

  <!-- Trade Status -->
  <div class="bg-neutral-soft border border-stone-200 rounded-lg p-4 mb-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-sm font-bold text-stone-800">トレード状態</h2>
        <p class="text-stone-500 text-xs mt-1">
          <%= I18n.t("activerecord.enums.trade.status.#{@trade.status}") %>
        </p>
      </div>
    </div>

    <!-- Aggregated Amounts Section (embedded in card) -->
    <%= render "aggregates_inline", trade: @trade %>
  </div>

  <!-- Card Offers Section -->
  <div class="mb-8">
    <%= render "trade_card_offers/list", list: @offers_list, sync_url: false %>

    <% if can_create %>
      <div class="mt-4">
        <button
          type="button"
          class="px-4 py-2 bg-offer text-white rounded-md hover:opacity-90 font-bold text-xs"
          id="add_offer_btn">
          カード明細を追加
        </button>
      </div>

      <% offer_frame_id = admin_context ? 'new_trade_card_offer_admin' : 'new_trade_card_offer' %>
      <turbo-frame id="<%= offer_frame_id %>" style="display: none;" class="mt-4 bg-stone-50 p-4 rounded-lg" data-controller="form-reset">
        <%= render 'trade_card_offers/form', trade_card_offer: @trade.trade_card_offers.build, frame_id: offer_frame_id, trade: @trade %>
      </turbo-frame>
    <% else %>
      <% offer_frame_id = admin_context ? 'new_trade_card_offer_admin' : 'new_trade_card_offer' %>
    <% end %>
  </div>

  <!-- Card Wants Section -->
  <div>
    <%= render "trade_card_wants/list", list: @wants_list, sync_url: false %>

    <% if can_create %>
      <div class="mt-4">
        <button
          type="button"
          class="px-4 py-2 bg-want text-white rounded-md hover:opacity-90 font-bold text-xs"
          id="add_want_btn">
          カード明細を追加
        </button>
      </div>

      <% want_frame_id = admin_context ? 'new_trade_card_want_admin' : 'new_trade_card_want' %>
      <turbo-frame id="<%= want_frame_id %>" style="display: none;" class="mt-4 bg-stone-50 p-4 rounded-lg" data-controller="form-reset">
        <%= render 'trade_card_wants/form', trade_card_want: @trade.trade_card_wants.build, frame_id: want_frame_id, trade: @trade %>
      </turbo-frame>
    <% else %>
      <% want_frame_id = admin_context ? 'new_trade_card_want_admin' : 'new_trade_card_want' %>
    <% end %>
  </div>

  <script>
    // Toggle add form buttons
    const addOfferBtn = document.getElementById('add_offer_btn');
    if (addOfferBtn) {
      addOfferBtn.addEventListener('click', function() {
        const frame = document.getElementById('<%= offer_frame_id %>');
        frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
      });
    }

    const addWantBtn = document.getElementById('add_want_btn');
    if (addWantBtn) {
      addWantBtn.addEventListener('click', function() {
        const frame = document.getElementById('<%= want_frame_id %>');
        frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
      });
    }

    // Mobile accordion expansion (delegated so rows appended/replaced by Turbo Streams work too).
    // Registered once: this inline script re-runs on every Turbo visit.
    if (!window.tradeCardExpandDelegated) {
      window.tradeCardExpandDelegated = true;
      document.addEventListener('click', function(e) {
        const button = e.target.closest('[data-toggle-expand]');
        if (!button) return;
        const table = button.closest('#trade_card_offers') || button.closest('#trade_card_wants');
        if (!table) return;
        e.preventDefault();
        const rowId = button.getAttribute('data-toggle-expand');
        const expandRow = document.getElementById('expand_' + rowId);
        if (!expandRow) return;
        const isHidden = expandRow.style.display === 'none';
        table.querySelectorAll('tr[id^="expand_"]').forEach(row => { row.style.display = 'none'; });
        table.querySelectorAll('tr[id^="edit_form_"]').forEach(row => { row.style.display = 'none'; });
        table.querySelectorAll('[data-toggle-expand]').forEach(btn => { btn.setAttribute('aria-expanded', 'false'); });
        if (isHidden) {
          expandRow.style.display = 'table-row';
          button.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Also listen for turbo:load for full page navigation
    document.addEventListener('turbo:load', function() {
      document.querySelectorAll('tr[id^="expand_"]').forEach(row => {
        row.style.display = 'none';
      });
      document.querySelectorAll('tr[id^="edit_form_"]').forEach(row => {
        row.style.display = 'none';
      });
    });

    // Hide expand buttons on desktop
    function updateExpandButtonVisibility() {
      const buttons = document.querySelectorAll('[data-toggle-expand]');
      const isDesktop = window.innerWidth >= 768;
      buttons.forEach(btn => {
        btn.style.display = isDesktop ? 'none' : 'inline-block';
      });
    }
    updateExpandButtonVisibility();
    window.addEventListener('resize', updateExpandButtonVisibility);
  </script>
</div>
