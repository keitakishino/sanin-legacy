<%
  id ||= "toast-#{SecureRandom.hex(4)}"
  duration ||= 4000
  # Clamp duration to valid range (100ms to 60 seconds)
  duration = [[duration.to_i, 100].max, 60000].min
%>
<div data-controller="toast"
     id="<%= id %>"
     class="relative bg-white border-l-4 border-success rounded-md shadow-lg p-4 max-w-sm w-full pointer-events-auto"
     data-toast-duration="<%= duration %>">

  <!-- Main content -->
  <div class="flex gap-3">
    <!-- Checkmark icon (SVG inline) -->
    <div class="flex-shrink-0 pt-0.5">
      <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>

    <!-- Message text -->
    <div class="flex-1">
      <p class="text-sm font-semibold text-stone-800"><%= message %></p>
    </div>

    <!-- Close button (手動クローズ) -->
    <button type="button"
            data-action="click->toast#close"
            class="flex-shrink-0 text-stone-400 hover:text-stone-600 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Progress bar (下部カウントダウン) -->
  <div class="mt-3 bg-stone-200 rounded-full h-1 overflow-hidden">
    <div class="bg-success h-full w-full"
         style="animation: toast-countdown <%= duration / 1000 %>s linear forwards;"></div>
  </div>
</div>
