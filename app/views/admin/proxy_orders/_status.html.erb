<div id="proxy_order_status" class="flex flex-col items-start gap-2">
  <div class="flex items-center gap-2">
    <span data-status="ordered" class="text-xs font-bold px-3 py-1 rounded-full <%= @proxy_order.ordered? ? 'bg-accent-soft text-accent' : 'text-stone-500' %>">
      <%= t("activerecord.enums.proxy_order.status.ordered") %>
    </span>
    <span class="text-stone-400 text-xs">→</span>
    <span data-status="arrived" class="text-xs font-bold px-3 py-1 rounded-full <%= @proxy_order.arrived? ? 'bg-accent-soft text-accent' : 'text-stone-500' %>">
      <%= t("activerecord.enums.proxy_order.status.arrived") %>
    </span>
    <span class="text-stone-400 text-xs">→</span>
    <span data-status="completed" class="text-xs font-bold px-3 py-1 rounded-full <%= @proxy_order.completed? ? 'bg-accent-soft text-accent' : 'text-stone-500' %>">
      <%= t("activerecord.enums.proxy_order.status.completed") %>
    </span>
  </div>

  <% if @transition_errors.present? %>
    <div id="proxy_order_status_errors" role="alert" class="bg-danger-soft border border-red-300 text-danger rounded-md px-4 py-3 text-sm font-semibold leading-relaxed max-w-md">
      <ul class="list-disc list-inside space-y-1">
        <% @transition_errors.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
