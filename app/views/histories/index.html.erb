<div class="container mx-auto px-4 py-8 max-w-6xl">
  <h1 class="text-3xl font-bold text-stone-800 mb-6">トレード履歴</h1>

  <% if @trades.any? %>
    <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
      <table class="w-full">
        <thead class="bg-neutral-soft border-b border-stone-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">イベント名</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">日時</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">出す枚数</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">ほしい枚数</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">差額</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">完了/キャンセル日時</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500 uppercase">キャンセル理由</th>
          </tr>
        </thead>
        <tbody id="trades">
          <% @trades.each do |trade| %>
            <tr class="border-b border-stone-200 hover:bg-stone-50">
              <td class="px-6 py-4 text-xs text-stone-800"><%= trade.event&.title || "（イベント情報不可）" %></td>
              <td class="px-6 py-4 text-xs text-stone-800"><%= trade.event&.event_date&.strftime("%Y年%m月%d日") || "—" %></td>
              <td class="px-6 py-4 text-xs text-stone-800"><%= trade.trade_card_offers.sum(:quantity) %></td>
              <td class="px-6 py-4 text-xs text-stone-800"><%= trade.trade_card_wants.sum(:quantity) %></td>
              <td class="px-6 py-4 text-xs text-stone-800"><%= number_with_delimiter(trade.net_amount) %></td>
              <td class="px-6 py-4 text-xs">
                <% case trade.status
                   when "pending"
                     badge_bg = "bg-neutral-soft"
                     badge_text = "text-stone-500"
                   when "in_progress"
                     badge_bg = "bg-warning-soft"
                     badge_text = "text-warning"
                   when "completed"
                     badge_bg = "bg-success-soft"
                     badge_text = "text-success"
                   when "cancelled"
                     badge_bg = "bg-danger-soft"
                     badge_text = "text-danger"
                   else
                     badge_bg = "bg-neutral-soft"
                     badge_text = "text-stone-500"
                   end %>
                <span class="px-3 py-1 rounded-full font-bold text-xs <%= badge_bg %> <%= badge_text %>">
                  <%= I18n.t("activerecord.enums.trade.status.#{trade.status}") %>
                </span>
              </td>
              <td class="px-6 py-4 text-xs text-stone-800">
                <% if trade.completed? %>
                  <%= trade.completed_at&.strftime("%Y年%m月%d日 %H:%M") || "—" %>
                <% elsif trade.cancelled? %>
                  <%= trade.updated_at&.strftime("%Y年%m月%d日 %H:%M") || "—" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-xs text-stone-800">
                <% if trade.cancelled_reason.present? %>
                  <span class="truncate" title="<%= trade.cancelled_reason %>"><%= trade.cancelled_reason %></span>
                <% else %>
                  <p class="text-stone-400">—</p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="mt-6">
      <%= paginate @trades %>
    </div>
  <% else %>
    <div class="bg-stone-50 rounded-lg p-6 text-center">
      <p class="text-stone-500 text-lg">完了またはキャンセルされたトレードはありません</p>
    </div>
  <% end %>
</div>
