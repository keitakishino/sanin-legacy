<div class="audit-log-exception-block">
  <% if heading %>
    <p class="text-xs font-bold text-stone-500 mb-1"><%= heading %></p>
  <% end %>
  <p class="font-mono text-xs font-bold text-red-700 break-all"><%= error_class %></p>
  <% if message %>
    <p class="text-xs text-stone-800 whitespace-pre-wrap break-all mt-1"><%= message %></p>
  <% end %>
  <% if backtrace %>
    <pre class="audit-log-backtrace mt-2 overflow-x-auto max-h-96 whitespace-pre text-xs font-mono bg-stone-50 border border-stone-200 rounded-md p-4"><%= backtrace %></pre>
  <% end %>
</div>
