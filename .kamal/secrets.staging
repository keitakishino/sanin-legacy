# Secrets for the `staging` destination (kamal ... -d staging).
# Kamal does NOT read the plain `.kamal/secrets` file when a destination is given —
# it reads `.kamal/secrets-common` then `.kamal/secrets.staging` only. See lib/kamal/secrets.rb.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# =========================================
# Staging Secrets
# =========================================

# Rails Master Key
# Same Rails app/credentials as production, so the same config/master.key is used.
RAILS_MASTER_KEY=$(cat config/master.key)

# Database Credentials
# DATABASE_HOST is the Kamal accessory's container name (not a secret), fixed per destination.
# Staging uses its own PostgreSQL accessory container (config/deploy.staging.yml), separate from production.
DATABASE_PASSWORD=$DATABASE_PASSWORD
DATABASE_HOST=sanin-legacy-staging-db
DATABASE_USER=$DATABASE_USER
DATABASE_PORT=$DATABASE_PORT

# Docker Registry Credentials
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# OAuth Credentials (Google)
GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=$GOOGLE_OAUTH_CLIENT_SECRET

# OAuth Credentials (Twitter/X)
TWITTER_OAUTH_API_KEY=$TWITTER_OAUTH_API_KEY
TWITTER_OAUTH_API_SECRET=$TWITTER_OAUTH_API_SECRET
