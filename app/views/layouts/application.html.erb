<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sanin Legacy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sanin Legacy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap">

    <!-- Google Fonts: Noto Sans JP -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-50">
    <header class="bg-white border-b border-stone-200" data-controller="hamburger-menu">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <!-- Logo and app name -->
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-accent rounded-[7px] flex items-center justify-center">
            <!-- Simplified card stack icon SVG -->
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
            </svg>
          </div>
          <h1 class="text-base font-bold text-stone-800" style="font-weight: 800; font-size: 17px;">Sanin Legacy</h1>
        </div>

        <!-- Hamburger menu button (mobile only) -->
        <% if user_signed_in? %>
          <button
            class="md:hidden w-8 h-8 flex items-center justify-center hover:bg-stone-100 rounded-md transition-colors"
            data-hamburger-menu-target="icon"
            data-action="click->hamburger-menu#toggle"
            aria-label="メニューを開く"
            type="button">
            <svg class="w-6 h-6 text-stone-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        <% end %>

        <!-- Navigation and user menu (desktop) -->
        <nav class="hidden md:flex items-center gap-6">
          <% if user_signed_in? && !current_user.role_admin? %>
            <!-- User screen navigation -->
            <div class="flex items-center gap-6">
              <%= link_to t("dashboards.show.title", default: "ダッシュボード"), root_path,
                  class: "text-sm font-semibold #{current_page?(root_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
              <%= link_to t("events.title", default: "イベント"), events_path,
                  class: "text-sm font-semibold #{current_page?(events_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
              <%= link_to t("histories.title", default: "トレード履歴"), histories_path,
                  class: "text-sm font-semibold #{current_page?(histories_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
            </div>

            <div class="flex items-center gap-4 ml-4 pl-4 border-l border-stone-200">
              <span class="text-sm text-stone-800"><%= current_user.username %></span>
              <%= link_to "マイページ", mypage_path, class: "text-sm text-stone-800 hover:text-accent font-semibold" %>
              <%= button_to "Sign Out", signout_path, method: :delete,
                  class: "px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs" %>
            </div>
          <% elsif user_signed_in? && current_user.role_admin? %>
            <!-- Admin navigation -->
            <div class="flex items-center gap-6">
              <%= link_to t("dashboards.show.title", default: "ダッシュボード"), root_path,
                  class: "text-sm font-semibold #{current_page?(root_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
              <%= link_to "イベント管理", admin_events_path,
                  class: "text-sm font-semibold #{current_page?(admin_events_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
              <%= link_to t("admin.users.nav_label"), admin_users_path,
                  class: "text-sm font-semibold #{current_page?(admin_users_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
              <%= link_to "招待コード管理", admin_invitations_path,
                  class: "text-sm font-semibold #{current_page?(admin_invitations_path) ? 'text-accent' : 'text-stone-800 hover:text-accent'}" %>
            </div>
            <div class="flex items-center gap-4 ml-4 pl-4 border-l border-stone-200">
              <div class="flex items-center gap-2">
                <span class="text-sm text-stone-800"><%= current_user.username %></span>
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-danger-soft text-danger">管理者</span>
              </div>
              <%= link_to "マイページ", mypage_path, class: "text-sm text-stone-800 hover:text-accent font-semibold" %>
              <%= button_to "Sign Out", signout_path, method: :delete,
                  class: "px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs" %>
            </div>
          <% else %>
            <!-- Not signed in -->
            <%= link_to "Sign In", signin_path,
                class: "px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs" %>
          <% end %>
        </nav>
      </div>

      <!-- Mobile drawer menu -->
      <div
        class="hidden fixed inset-0 top-16 md:hidden bg-white border-b border-stone-200 flex flex-col gap-4 p-4 z-40 w-screen transition-all duration-200"
        data-hamburger-menu-target="drawer"
        aria-hidden="true">
        <% if user_signed_in? && !current_user.role_admin? %>
          <!-- User navigation links -->
          <nav class="flex flex-col gap-3">
            <%= link_to t("dashboards.show.title", default: "ダッシュボード"), root_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= link_to t("events.title", default: "イベント"), events_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= link_to t("histories.title", default: "トレード履歴"), histories_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
          </nav>

          <div class="border-t border-stone-200 pt-3 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-stone-800"><%= current_user.username %></span>
            </div>
            <%= link_to "マイページ", mypage_path,
                class: "text-sm text-stone-800 hover:text-accent font-semibold py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= button_to "Sign Out", signout_path, method: :delete,
                class: "w-full px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs text-left",
                data: { action: "click->hamburger-menu#close" } %>
          </div>
        <% elsif user_signed_in? && current_user.role_admin? %>
          <!-- Admin navigation links -->
          <nav class="flex flex-col gap-3">
            <%= link_to t("dashboards.show.title", default: "ダッシュボード"), root_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= link_to "イベント管理", admin_events_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= link_to t("admin.users.nav_label"), admin_users_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= link_to "招待コード管理", admin_invitations_path,
                class: "text-sm font-semibold text-stone-800 hover:text-accent py-2",
                data: { action: "click->hamburger-menu#close" } %>
          </nav>

          <div class="border-t border-stone-200 pt-3 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-stone-800"><%= current_user.username %></span>
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-danger-soft text-danger">管理者</span>
            </div>
            <%= link_to "マイページ", mypage_path,
                class: "text-sm text-stone-800 hover:text-accent font-semibold py-2",
                data: { action: "click->hamburger-menu#close" } %>
            <%= button_to "Sign Out", signout_path, method: :delete,
                class: "w-full px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs text-left",
                data: { action: "click->hamburger-menu#close" } %>
          </div>
        <% else %>
          <!-- Not signed in -->
          <div>
            <%= link_to "Sign In", signin_path,
                class: "block px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs text-center",
                data: { action: "click->hamburger-menu#close" } %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto px-4 py-8">
      <!-- Flash messages with design-token colors -->
      <% if flash[:alert] %>
        <div class="bg-danger-soft border border-red-300 text-danger px-4 py-3 rounded-md mb-4 font-semibold text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="bg-success-soft border border-emerald-300 text-success px-4 py-3 rounded-md mb-4 font-semibold text-sm">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-4 right-4 flex flex-col gap-2 z-50"></div>
  </body>
</html>
