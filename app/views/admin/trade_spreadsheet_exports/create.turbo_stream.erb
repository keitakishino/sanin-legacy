<%= turbo_stream.update "spreadsheet_export_result" do %>
  <div class="mt-4">
    <div id="spreadsheet_export_message" class="px-4 py-2 rounded-lg <%= @success ? "bg-green-100 text-green-700 border border-green-300" : "bg-red-100 text-red-700 border border-red-300" %>">
      <%= @message %>
    </div>
  </div>
<% end %>

<% if @success %>
  <%= turbo_stream.update "trade_spreadsheet_exported_at" do %>
    <strong>最終エクスポート:</strong>
    <%= Time.current.strftime("%Y年%m月%d日 %H:%M") %>
    (by <%= current_user.username %>)
  <% end %>
<% end %>
