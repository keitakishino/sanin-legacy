<div class="px-4 py-8 flex flex-col gap-8">
  <div class="flex flex-wrap justify-between items-start gap-4">
    <div>
      <%= link_to t("proxy_orders.show.back_to_dashboard"), root_path, class: "inline-block mb-4 text-accent hover:text-accent-hover font-bold text-sm" %>
      <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
      <p class="text-xs text-stone-500">
        <span class="inline-block px-[10px] py-0.5 rounded-full bg-accent-soft text-accent font-bold mr-2"><%= t("activerecord.attributes.event.event_types.proxy_order") %></span>
        <%= t("admin.proxy_order.event_date", date: l(@event.event_date.to_date, format: :long)) %>
        ／ <%= t("proxy_orders.show.view_only_note") %>
      </p>
    </div>

    <div id="proxy_order_status" class="flex items-center gap-2">
      <% ProxyOrder.statuses.keys.each_with_index do |status, index| %>
        <% if index.positive? %><span class="text-stone-400 text-xs">→</span><% end %>
        <span data-status="<%= status %>" class="text-xs font-bold px-3 py-1 rounded-full <%= @proxy_order.status == status ? 'bg-accent-soft text-accent' : 'text-stone-500' %>">
          <%= t("activerecord.enums.proxy_order.status.#{status}") %>
        </span>
      <% end %>
    </div>
  </div>

  <section class="bg-neutral-soft border border-stone-200 rounded-lg p-4 flex justify-between items-center gap-4">
    <div>
      <h2 class="text-sm font-bold text-stone-800"><%= t("proxy_orders.show.status_label") %></h2>
      <p class="mt-1 text-xs text-stone-500"><%= t("activerecord.enums.proxy_order.status.#{@proxy_order.status}") %></p>
    </div>
    <div class="text-right">
      <h2 class="text-sm font-bold text-stone-800"><%= t("proxy_orders.show.handover_label") %></h2>
      <p class="mt-1 text-xs text-stone-500">
        <%= @participant.handed_over_at? ? t("proxy_orders.show.handed_over") : t("proxy_orders.show.not_handed_over") %>
      </p>
    </div>
  </section>

  <% if @proxy_order.ordered? %>
    <div id="proxy_order_provisional" role="status" class="bg-accent-soft border border-border rounded-lg p-4 text-sm text-stone-700">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-white text-accent mr-2"><%= t("proxy_orders.show.provisional") %></span>
      <%= t("proxy_orders.show.provisional_notice") %>
    </div>
  <% end %>

  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <section class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold text-stone-800 mb-4"><%= t("proxy_orders.show.my_cards") %></h2>

      <% if @allocations.any? %>
        <div class="border border-stone-200 rounded-lg overflow-x-auto bg-white">
          <table id="proxy_order_my_items" class="w-full text-sm tabular-nums">
            <thead class="bg-stone-100 border-b border-stone-200">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.card_name") %></th>
                <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.expansion") %></th>
                <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.foil") %></th>
                <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("proxy_orders.show.frame") %></th>
                <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.quantity") %></th>
                <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.lost") %></th>
                <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.per_card") %></th>
                <th class="px-4 py-3 text-right text-xs font-bold text-stone-500"><%= t("proxy_orders.show.subtotal") %></th>
              </tr>
            </thead>
            <tbody>
              <% @allocations.each do |allocation| %>
                <tr id="<%= dom_id(allocation) %>" class="border-t border-stone-200 border-l-[3px] border-l-offer">
                  <td class="px-4 py-3"><%= allocation.proxy_order_item.card_name %></td>
                  <td class="px-4 py-3"><%= allocation.proxy_order_item.expansion&.scryfall_set_code&.upcase %></td>
                  <td class="px-4 py-3"><%= foil_label(allocation.proxy_order_item) %></td>
                  <td class="px-4 py-3"><%= frame_label(allocation.proxy_order_item) %></td>
                  <td class="px-4 py-3 text-right"><%= allocation.quantity %></td>
                  <td class="px-4 py-3 text-right"><%= allocation.lost_quantity %></td>
                  <td class="px-4 py-3 text-right"><%= usd(@calculator.unit_price(allocation.proxy_order_item)) %></td>
                  <td class="px-4 py-3 text-right"><%= usd(@calculator.subtotal(allocation)) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-stone-500 leading-relaxed"><%= t("proxy_orders.show.note_average") %></p>
        <% if @proxy_order.ordered? %>
          <p class="mt-2 text-xs text-stone-500 leading-relaxed"><%= t("proxy_orders.show.note_provisional") %></p>
        <% end %>
      <% else %>
        <p class="text-stone-600 bg-white border border-stone-200 rounded-lg p-4"><%= t("proxy_orders.show.no_items") %></p>
      <% end %>
    </section>

    <aside id="proxy_order_my_payment" class="w-full lg:w-80 lg:flex-none bg-white border border-stone-200 rounded-lg p-4 flex flex-col gap-3">
      <h2 class="text-xl font-bold text-stone-800"><%= t("proxy_orders.show.my_payment") %></h2>

      <div class="bg-stone-50 border border-stone-200 rounded p-4">
        <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase"><%= t("proxy_orders.show.tile_goods") %></p>
        <p data-role="goods-total" class="m-0 text-xl font-extrabold tabular-nums text-sky-700"><%= usd(@calculator.goods_total(@participant)) %></p>
      </div>

      <div class="bg-stone-50 border border-stone-200 rounded p-4">
        <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase"><%= t("proxy_orders.show.tile_fee", total: usd(@calculator.fee_total), count: @calculator.fee_payer_count) %></p>
        <p data-role="fee" class="m-0 text-xl font-extrabold tabular-nums text-sky-700"><%= usd(@calculator.fee_for(@participant)) %></p>
      </div>

      <div class="bg-stone-50 border border-stone-200 rounded p-4">
        <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase">
          <%= t("proxy_orders.show.tile_payment") %>
          <% if @proxy_order.ordered? %>
            <span class="inline-block px-2 py-0.5 rounded-full bg-accent-soft text-accent normal-case"><%= t("proxy_orders.show.provisional") %></span>
          <% end %>
        </p>
        <p data-role="payment-jpy" class="m-0 text-xl font-extrabold tabular-nums text-emerald-700"><%= jpy_or_pending(@calculator.payment_jpy(@participant)) %></p>
      </div>

      <p class="m-0 text-xs text-stone-500 tabular-nums">
        <span data-role="payment-usd"><%= usd(@calculator.payment_usd(@participant)) %></span>
        <% if @proxy_order.usd_jpy_rate.present? %>
          <%= t("proxy_orders.show.calc_line",
                usd: "", rate: number_with_precision(@proxy_order.usd_jpy_rate, precision: 2),
                raw: jpy_or_pending((@calculator.payment_usd(@participant) * @proxy_order.usd_jpy_rate).round),
                rounded: jpy_or_pending(@calculator.payment_jpy(@participant))) %>
        <% end %>
      </p>
    </aside>
  </div>
</div>
