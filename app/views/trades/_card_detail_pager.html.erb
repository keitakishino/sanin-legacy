<% if list.records.total_pages > 1 %>
  <nav id="<%= list.prefix %>_pagination" class="flex gap-2 justify-center mt-4" aria-label="<%= list.prefix %> pager">
    <% if list.records.current_page > 1 %>
      <%= link_to "前", card_detail_list_url(list, page: list.records.current_page - 1), class: "px-2 py-1 text-xs border border-stone-200 rounded hover:bg-stone-100" %>
    <% end %>

    <% (1..list.records.total_pages).each do |page_num| %>
      <% if page_num == list.records.current_page %>
        <span class="px-2 py-1 text-xs bg-stone-200 rounded" aria-current="page"><%= page_num %></span>
      <% else %>
        <%= link_to page_num, card_detail_list_url(list, page: page_num), class: "px-2 py-1 text-xs border border-stone-200 rounded hover:bg-stone-100" %>
      <% end %>
    <% end %>

    <% if list.records.current_page < list.records.total_pages %>
      <%= link_to "次", card_detail_list_url(list, page: list.records.current_page + 1), class: "px-2 py-1 text-xs border border-stone-200 rounded hover:bg-stone-100" %>
    <% end %>
  </nav>
<% end %>
