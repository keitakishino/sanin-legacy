<!-- Replace the whole row group (main row + mobile expansion row + edit form row) as one atomic -->
<!-- unit so the freshly rendered edit form (closed by default) fully replaces the old one, with -->
<!-- no leftover/duplicate row sharing the same id. -->
<%= turbo_stream.replace dom_id(@trade_card_offer, :group) do %>
  <%= render(partial: 'trade_card_offer', locals: { trade_card_offer: @trade_card_offer }, formats: [:html]) %>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.update', card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
