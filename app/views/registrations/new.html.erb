<div class="bg-stone-50 min-h-screen flex items-center justify-center -mx-4 -my-8">
  <div class="bg-white border border-stone-200 rounded-lg p-8 max-w-xs w-full">
    <h2 class="text-2xl font-bold text-stone-800 mb-6">サインアップ</h2>

    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-danger-soft border border-danger rounded-md">
        <p class="text-danger text-sm font-semibold"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div>
      <h3 class="text-lg font-bold text-stone-800 mb-4">認証方式を選択</h3>

      <div class="space-y-3">
        <button type="button" class="w-full px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs" onclick="showEmailForm()">
          メール＆パスワード
        </button>

        <%= button_to "/auth/google", method: :post, data: { turbo: false }, class: "w-full px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs" do %>
          Google でサインアップ
        <% end %>

        <%= button_to "/auth/twitter", method: :post, data: { turbo: false }, class: "w-full px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs" do %>
          X でサインアップ
        <% end %>
      </div>
    </div>

    <div id="email-form" class="hidden mt-6">
      <hr class="mb-6 border-stone-200">
      <h3 class="text-lg font-bold text-stone-800 mb-4">メール＆パスワード登録</h3>

      <%= form_with url: "/signup", local: true do |f| %>
        <%= f.hidden_field :auth_method, value: "email" %>

        <div class="mb-4">
          <%= f.label :email, "メールアドレス", class: "block text-xs font-bold text-stone-500 mb-2" %>
          <%= f.email_field :email, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
        </div>

        <div class="mb-4">
          <%= f.label :password, "パスワード", class: "block text-xs font-bold text-stone-500 mb-2" %>
          <%= f.password_field :password, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true, placeholder: "8文字以上" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "パスワード確認", class: "block text-xs font-bold text-stone-500 mb-2" %>
          <%= f.password_field :password_confirmation, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.submit "アカウント作成", class: "px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs" %>
          <button type="button" class="text-stone-500 hover:text-stone-700 text-xs font-semibold" onclick="hideEmailForm()">キャンセル</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function showEmailForm() {
    document.getElementById('email-form').classList.remove('hidden');
  }

  function hideEmailForm() {
    document.getElementById('email-form').classList.add('hidden');
  }
</script>
