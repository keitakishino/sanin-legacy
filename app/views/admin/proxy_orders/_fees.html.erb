<div id="proxy_order_fees" class="bg-white border border-stone-200 rounded-lg mb-6">
  <div class="p-6">
    <h2 class="text-lg font-bold text-stone-800 mb-4"><%= t("admin.proxy_order.fees") %></h2>

    <%= form_with model: @proxy_order, url: admin_event_proxy_order_path(@event), method: :patch, id: "proxy_order_fees_form", local: true do |f| %>
      <% if @proxy_order.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
          <ul class="list-disc list-inside space-y-1 text-red-700 text-sm">
            <% @proxy_order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :tax_usd, t("activerecord.attributes.proxy_order.tax_usd"), class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.number_field :tax_usd, step: 0.01, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent disabled:bg-stone-100 disabled:text-stone-500", disabled: !@proxy_order.fees_editable? %>
      </div>

      <div class="mb-4">
        <%= f.label :customs_usd, t("activerecord.attributes.proxy_order.customs_usd"), class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.number_field :customs_usd, step: 0.01, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent disabled:bg-stone-100 disabled:text-stone-500", disabled: !@proxy_order.fees_editable? %>
      </div>

      <div class="mb-4">
        <%= f.label :shipping_usd, t("activerecord.attributes.proxy_order.shipping_usd"), class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.number_field :shipping_usd, step: 0.01, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent disabled:bg-stone-100 disabled:text-stone-500", disabled: !@proxy_order.fees_editable? %>
      </div>

      <div class="mb-6">
        <%= f.label :usd_jpy_rate, t("activerecord.attributes.proxy_order.usd_jpy_rate"), class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.number_field :usd_jpy_rate, step: 0.0001, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent disabled:bg-stone-100 disabled:text-stone-500", disabled: !@proxy_order.fees_editable? %>
      </div>

      <% if @proxy_order.fees_editable? %>
        <%= f.submit t("common.save"), class: "bg-indigo-700 text-white px-4 py-2 rounded hover:bg-indigo-800 font-medium text-sm cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</div>
