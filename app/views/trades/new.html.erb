<%= form_with model: @trade do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :contact %>
    <%= form.collection_radio_buttons :contact, Trade.contacts, :last, :first %>
  </div>

  <div>
    <%= form.label :contact_account %>
    <%= form.text_field :contact_account %>
  </div>

  <div>
    <%= form.label :residue %>
    <%= form.collection_radio_buttons :residue, Trade.residues, :last, :first %>
  </div>

  <div>
    <%= form.label :memo %>
    <%= form.textarea :memo %>
  </div>

  <%= form.submit %>
<% end %>
