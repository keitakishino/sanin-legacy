<section id="proxy_order_fees" class="bg-neutral-soft border border-stone-200 rounded-lg p-4 flex flex-col gap-4">
  <div>
    <h3 class="text-sm font-bold text-stone-800"><%= t("admin.proxy_order.fees_and_rate") %></h3>
    <p class="mt-1 text-xs text-stone-500">
      <% if @proxy_order.ordered? %><%= t("admin.proxy_order.fees_note_ordered") %>
      <% elsif @proxy_order.arrived? %><%= t("admin.proxy_order.fees_note_arrived") %>
      <% else %><%= t("admin.proxy_order.fees_note_completed") %><% end %>
    </p>
  </div>

  <%= form_with model: @proxy_order, url: admin_event_proxy_order_path(@event), method: :patch, id: "proxy_order_fees_form", local: true, class: "flex flex-col gap-4" do |f| %>
    <% if @proxy_order.errors.any? %>
      <div role="alert" class="bg-red-50 border border-red-200 rounded-md p-4">
        <ul class="list-disc list-inside space-y-1 text-red-700 text-sm">
          <% @proxy_order.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% [[:tax_usd, "label_tax", 0.01], [:customs_usd, "label_customs", 0.01], [:shipping_usd, "label_shipping", 0.01], [:usd_jpy_rate, "label_rate", 0.0001]].each do |attr, key, step| %>
        <label class="block">
          <span class="block text-xs font-bold text-stone-500 mb-1"><%= t("admin.proxy_order.#{key}") %></span>
          <%= f.number_field attr, step: step, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs tabular-nums bg-white focus:outline-none focus:ring-2 focus:ring-accent disabled:bg-stone-100 disabled:text-stone-500", disabled: !@proxy_order.fees_editable? %>
        </label>
      <% end %>
    </div>

    <% if @proxy_order.fees_editable? %>
      <div><%= f.submit t("common.save"), class: "bg-accent text-white px-4 py-2 rounded-md hover:bg-accent-hover font-bold text-xs cursor-pointer" %></div>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-stone-50 border border-stone-200 rounded p-4">
      <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase"><%= t("admin.proxy_order.tile_fee_total") %></p>
      <p class="m-0 text-xl font-extrabold tabular-nums text-stone-800"><%= usd(@calculator.fee_total) %></p>
    </div>
    <div class="bg-stone-50 border border-stone-200 rounded p-4">
      <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase"><%= t("admin.proxy_order.tile_fee_per_person", count: @calculator.fee_payer_count) %></p>
      <p id="proxy_order_fee_per_person" class="m-0 text-xl font-extrabold tabular-nums text-sky-700"><%= usd(@calculator.fee_per_person) %></p>
    </div>
    <div class="bg-stone-50 border border-stone-200 rounded p-4">
      <p class="m-0 mb-1 text-[11px] font-bold text-stone-400 uppercase">
        <%= @proxy_order.ordered? ? "#{t('admin.proxy_order.tile_payment_total')}（#{t('admin.proxy_order.provisional')}）" : t("admin.proxy_order.tile_payment_total") %>
      </p>
      <p class="m-0 text-xl font-extrabold tabular-nums text-emerald-700"><%= jpy_or_pending(total_payment_jpy(@calculator, @participants)) %></p>
    </div>
  </div>
</section>
