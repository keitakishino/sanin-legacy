<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold mb-6">プロフィール編集</h1>

  <% if @user.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h2 class="text-red-800 font-semibold text-lg mb-2">
        <%= pluralize(@user.errors.count, "件") %>のエラーがあります
      </h2>
      <ul class="list-disc list-inside text-red-700">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, local: true, url: "/mypage", method: :patch, class: "space-y-6" do |form| %>
    <!-- ユーザー名 -->
    <div>
      <%= form.label :username, "ユーザー名", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :username, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <!-- メールアドレス -->
    <div>
      <%= form.label :email, "メールアドレス", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.email_field :email, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      <p class="text-gray-500 text-sm mt-1">空欄のままにすると、メールアドレスは未設定になります</p>
    </div>

    <!-- パスワード変更 -->
    <fieldset class="border-t pt-6">
      <legend class="text-sm font-semibold text-gray-700 mb-4">パスワード変更（オプション）</legend>

      <div>
        <%= form.label :password, "新しいパスワード", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.password_field :password, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <p class="text-gray-500 text-sm mt-1">8文字以上で入力してください</p>
      </div>

      <div class="mt-4">
        <%= form.label :password_confirmation, "パスワード確認", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.password_field :password_confirmation, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
    </fieldset>

    <!-- ボタン -->
    <div class="flex gap-4 pt-4">
      <%= form.submit "保存", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold" %>
      <%= link_to "キャンセル", mypage_path, class: "px-6 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 font-semibold" %>
    </div>
  <% end %>
</div>
