<turbo-frame id="event_modal">
  <div class="fixed inset-0 bg-black/55 flex items-center justify-center p-4 z-50">
    <div class="bg-white border border-stone-200 rounded-[10px] max-w-2xl w-full max-h-96 overflow-y-auto flex flex-col">
      <!-- Header with close button -->
      <div class="bg-neutral-soft border-b border-stone-200 px-6 py-4 flex items-center justify-between sticky top-0">
        <h2 class="text-2xl font-bold text-stone-800"><%= @event.title %></h2>
        <button type="button" data-turbo-frame="event_modal"
                onclick="document.getElementById('event_modal').innerHTML = ''"
                class="text-stone-400 hover:text-stone-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="px-6 py-6 space-y-6 flex-grow overflow-y-auto">
        <!-- Event date -->
        <div>
          <h3 class="text-xs font-bold text-stone-500 uppercase mb-2">開催日</h3>
          <p class="text-base text-stone-800">
            <%= @event.event_date.strftime("%Y年%m月%d日") %>
          </p>
        </div>

        <!-- Description -->
        <div>
          <h3 class="text-xs font-bold text-stone-500 uppercase mb-2">説明</h3>
          <% if @event.description.present? %>
            <p class="text-sm text-stone-800 whitespace-pre-wrap"><%= @event.description %></p>
          <% else %>
            <p class="text-sm text-stone-400">説明はありません</p>
          <% end %>
        </div>

        <!-- Created by -->
        <div>
          <h3 class="text-xs font-bold text-stone-500 uppercase mb-2">作成者</h3>
          <p class="text-sm text-stone-800">
            <%= @event.created_by&.username %>
          </p>
        </div>

        <!-- Creation date -->
        <div>
          <h3 class="text-xs font-bold text-stone-500 uppercase mb-2">作成日時</h3>
          <p class="text-sm text-stone-800">
            <%= @event.created_at.strftime("%Y年%m月%d日 %H:%M") %>
          </p>
        </div>
      </div>

      <!-- Footer with action and close buttons -->
      <div class="bg-neutral-soft border-t border-stone-200 px-6 py-4 flex justify-between gap-2">
        <%= link_to "自分のトレードを編集する", trade_path(@event.id),
            class: "px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs",
            data: { turbo_frame: "_top" } %>
        <button type="button" data-turbo-frame="event_modal"
                onclick="document.getElementById('event_modal').innerHTML = ''"
                class="px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs">
          閉じる
        </button>
      </div>
    </div>
  </div>
</turbo-frame>
