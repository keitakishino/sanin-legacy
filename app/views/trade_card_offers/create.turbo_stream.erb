<% admin_context = @trade_id.present? %>
<% frame_id = admin_context ? 'new_trade_card_offer_admin' : 'new_trade_card_offer' %>

<%= turbo_stream.append "trade_card_offers" do %>
  <%= render 'trade_card_offer', trade_card_offer: @trade_card_offer %>
<% end %>

<% if @trade.trade_card_offers.count == 1 %>
  <%= turbo_stream.remove "trade_card_offers_empty" %>
<% end %>

<%= turbo_stream.replace frame_id do %>
  <turbo-frame id="<%= frame_id %>" style="display: none;" class="mt-4 bg-stone-50 p-4 rounded-lg">
    <%= render(partial: 'form', locals: { trade_card_offer: @trade.trade_card_offers.build, frame_id: frame_id }, formats: [:html]) %>
  </turbo-frame>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: "shared/toast", locals: { message: t("toasts.trade_card_offer.create", card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
