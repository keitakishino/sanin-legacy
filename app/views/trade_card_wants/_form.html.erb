<% if trade_card_want.persisted? %>
  <% form_url = trade_card_want_path(@trade.event, trade_card_want) %>
  <% form_method = :patch %>
<% else %>
  <% form_url = trade_card_wants_path(@trade.event) %>
  <% form_method = :post %>
<% end %>

<% frame_id ||= "new_trade_card_want" %>

<%= form_with url: form_url, method: form_method, local: true, data: { turbo: true } do |f| %>
  <!-- Hidden trade_id for admin operations only -->
  <% if current_user.role_admin? %>
    <%= hidden_field_tag :trade_id, @trade.id %>
  <% end %>

  <% if trade_card_want.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
      <h2 class="text-red-800 font-semibold mb-2">
        <%= pluralize(trade_card_want.errors.count, "error") %> prohibited this record from being saved:
      </h2>
      <ul class="list-disc list-inside space-y-1 text-red-700">
        <% trade_card_want.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <!-- Card Name -->
    <div>
      <%= f.label :card_name, "カード名", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.text_field :card_name, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Quantity -->
    <div>
      <%= f.label :quantity, "数量", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.number_field :quantity, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Language (nullable) -->
    <div>
      <%= f.label :language, "言語 (不問なら未選択)", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.select :language, [["不問", nil]] + TradeCardWant.languages.keys.map { |k| [I18n.t("activerecord.enums.trade_card_want.language.#{k}"), k] }, { prompt: "選択してください" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Conditions (array field) -->
    <div>
      <%= f.label :conditions, "状態 (不問ならチェックなし)", class: "block text-xs font-bold text-stone-500 mb-2" %>
      <div class="space-y-2">
        <% [["NM", 0], ["SP", 1], ["MP", 2], ["HP", 3], ["POOR", 4]].each do |label, value| %>
          <label class="flex items-center gap-2 text-xs text-stone-700 font-medium">
            <%= f.check_box :conditions, { multiple: true, include_hidden: false }, value, nil %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Foil (nullable) -->
    <div>
      <%= f.label :foil, "フォイル (不問なら未選択)", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.select :foil, [["不問", nil]] + TradeCardWant.foils.keys.map { |k| [I18n.t("activerecord.enums.trade_card_want.foil.#{k}"), k] }, { prompt: "選択してください" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Frame (nullable) -->
    <div>
      <%= f.label :frame, "フレーム (不問なら未選択)", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.select :frame, [["不問", nil]] + TradeCardWant.frames.keys.map { |k| [I18n.t("activerecord.enums.trade_card_want.frame.#{k}"), k] }, { prompt: "選択してください" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Expansion (Combobox) -->
    <div data-controller="expansion-select" class="relative">
      <%= f.label :expansion_id, "セット", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <input type="text"
             data-target="expansion-select.input"
             data-action="keyup->expansion-select#search blur->expansion-select#hideDropdown"
             placeholder="セットコードで検索（例: VOW）"
             class="w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" />
      <%= f.hidden_field :expansion_id, data: { target: "expansion-select.select" } %>

      <!-- Dropdown frame with suggestions -->
      <turbo-frame id="expansion_suggestions"
                   data-target="expansion-select.frame"
                   class="absolute w-full mt-1 bg-white border border-stone-300 rounded-md shadow-lg z-10"
                   style="display: none;">
      </turbo-frame>
    </div>

    <!-- Note -->
    <div>
      <%= f.label :note, "備考", class: "block text-xs font-bold text-stone-500 mb-1" %>
      <%= f.text_area :note, rows: 3, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <!-- Amount (admin only) -->
    <% if current_user.role_admin? %>
      <div>
        <%= f.label :amount, "金額 (管理者のみ)", class: "block text-xs font-bold text-stone-500 mb-1" %>
        <%= f.number_field :amount, class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>
    <% end %>

    <!-- Submit buttons -->
    <div class="flex gap-2 pt-4">
      <%= f.submit trade_card_want.persisted? ? "更新" : "追加", class: "px-4 py-2 bg-want text-white rounded-md hover:opacity-90 font-bold text-xs" %>
      <button type="button" class="px-4 py-2 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs"
              onclick="document.getElementById('<%= dom_id(trade_card_want, :edit_form) %>').style.display = 'none'">
        キャンセル
      </button>
    </div>
  </div>
<% end %>
