<turbo-stream action="replace" target="<%= dom_id(@trade_card_offer, :edit_form) %>">
  <template>
    <turbo-frame id="<%= dom_id(@trade_card_offer, :edit_form) %>" class="mt-4 border-t pt-4">
      <%= render(partial: 'form', locals: { trade_card_offer: @trade_card_offer }, formats: [:html]) %>
    </turbo-frame>
  </template>
</turbo-stream>

<% if @trade_card_offer.errors.any? %>
  <turbo-stream action="append" target="toast-container">
    <template><%= render(partial: "shared/toast", locals: { message: @trade_card_offer.errors.full_messages.join(", "), variant: :danger }, formats: [:html]) %></template>
  </turbo-stream>
<% end %>
