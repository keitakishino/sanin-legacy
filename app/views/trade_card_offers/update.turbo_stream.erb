<%= turbo_stream.replace dom_id(@trade_card_offer) do %>
  <%= render 'trade_card_offer', trade_card_offer: @trade_card_offer %>
<% end %>

<!-- Hide the edit form row and reset form after successful update -->
<%= turbo_stream.replace dom_id(@trade_card_offer, :edit_form) do %>
  <tr id="<%= dom_id(@trade_card_offer, :edit_form) %>" class="border-b border-stone-200" style="border-left: 3px solid oklch(52% 0.12 231); display: none;" data-controller="form-reset">
    <td colspan="12" class="px-4 py-4 bg-stone-50">
      <turbo-frame id="<%= dom_id(@trade_card_offer, :edit_form_frame) %>" class="">
        <%= render 'trade_card_offers/form', trade_card_offer: @trade_card_offer, frame_id: dom_id(@trade_card_offer, :edit_form_frame) %>
      </turbo-frame>
    </td>
  </tr>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.update', card_name: @trade_card_offer.card_name) }, formats: [:html]) %>
<% end %>
