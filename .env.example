# =========================================
# Development Environment Configuration
# =========================================

# Database (docker-compose environment)
DATABASE_HOST=db
DATABASE_USER=sanin_legacy
DATABASE_PASSWORD=development_password
DATABASE_PORT=5432

# Docker Compose Port Configuration
# デフォルト値を使用する場合はコメントアウトしたままにしてください
# worktree作成時に scripts/create_worktree.sh により自動設定されます
# DB_PORT=5432
# APP_PORT=3000

# Rails
RAILS_ENV=development

# OmniAuth (Google) - Development
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# OmniAuth (Twitter/X) - Development
TWITTER_OAUTH_API_KEY=your_api_key_here
TWITTER_OAUTH_API_SECRET=your_api_secret_here

# =========================================
# Production Environment Configuration
# =========================================
# The following variables are required for production deployment via Kamal.
# Do NOT enter raw credentials here. Instead, define them in .kamal/secrets
# and they will be injected into the container at deployment time.

# Rails Master Key
# RAILS_MASTER_KEY is NOT set in .env for production. It is automatically
# extracted from config/master.key file and injected via .kamal/secrets.
# See: .kamal/secrets for implementation details.

# Database Configuration (Production)
# These must be defined in .kamal/secrets for production.
# DATABASE_HOST=your-production-db-host
# DATABASE_USER=your-production-db-user
# DATABASE_PASSWORD=your-production-db-password
# DATABASE_PORT=5432

# Docker Registry Credentials (Production)
# For pulling/pushing images from Docker Hub or other registries.
# KAMAL_REGISTRY_PASSWORD=your-docker-registry-access-token

# OmniAuth (Google) - Production
# GOOGLE_OAUTH_CLIENT_ID=your-production-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-production-client-secret

# OmniAuth (Twitter/X) - Production
# TWITTER_OAUTH_API_KEY=your-production-api-key
# TWITTER_OAUTH_API_SECRET=your-production-api-secret
