<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-4">ダッシュボード</h1>
    <p class="text-gray-600 text-sm">
      未完了のトレード一覧です。進捗状況を確認して管理してください。
    </p>
  </div>

  <!-- Incomplete Trades Section with Turbo Frame -->
  <turbo-frame id="incomplete_trades">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">未完了トレード</h2>

      <% if @incomplete_trades.any? %>
        <div class="space-y-4">
          <% @incomplete_trades.each do |trade| %>
            <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <!-- Event and Trade Info -->
                  <p class="text-lg font-semibold text-gray-800 mb-2">
                    <%= trade.event.title %>
                  </p>
                  <p class="text-sm text-gray-600 mb-4">
                    開催日: <%= trade.event.event_date.strftime("%Y年%m月%d日") %>
                  </p>

                  <!-- Status Badge -->
                  <div class="mb-4">
                    <% status_badge_class = trade.status == "pending" ? "bg-gray-200 text-gray-800" : "bg-blue-200 text-blue-800" %>
                    <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold <%= status_badge_class %>">
                      <%= I18n.t("activerecord.enums.trade.status.#{trade.status}") %>
                    </span>
                  </div>

                  <!-- Aggregates -->
                  <div class="grid grid-cols-3 gap-4 text-sm">
                    <div>
                      <p class="text-gray-600 text-xs uppercase">出す合計</p>
                      <p class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(trade.offers_total_amount) %> 円</p>
                    </div>
                    <div>
                      <p class="text-gray-600 text-xs uppercase">欲しい合計</p>
                      <p class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(trade.wants_total_amount) %> 円</p>
                    </div>
                    <div>
                      <p class="text-gray-600 text-xs uppercase">差分</p>
                      <% net_class = trade.net_amount >= 0 ? "text-green-600" : "text-red-600" %>
                      <p class="text-lg font-semibold <%= net_class %>">
                        <%= number_with_delimiter(trade.net_amount) %> 円
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Action Link -->
                <div class="ml-4">
                  <%= link_to "詳細を表示", trade_path(trade.event_id),
                      class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold inline-block whitespace-nowrap" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-gray-50 rounded-lg p-8 text-center">
          <p class="text-gray-500 text-lg mb-4">トレードはまだありません</p>
          <p class="text-gray-600 text-sm mb-6">
            イベント一覧からトレードを開始してください。
          </p>
          <%= link_to "イベント一覧へ", events_path,
              class: "text-blue-600 hover:text-blue-800 font-semibold" %>
        </div>
      <% end %>
    </div>
  </turbo-frame>

  <!-- Navigation -->
  <div class="mt-8 pt-8 border-t border-gray-200">
    <%= link_to "イベント一覧を見る", events_path,
        class: "text-blue-600 hover:text-blue-800 font-semibold" %>
  </div>
</div>
