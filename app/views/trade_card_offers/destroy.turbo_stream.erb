<turbo-stream action="remove" target="<%= dom_id(@trade_card_offer) %>">
</turbo-stream>

<% if @trade_card_offer.trade.trade_card_offers.count == 0 %>
  <% admin_context = @trade_id.present? %>
  <% empty_classes = admin_context ? 'text-stone-500 text-center py-8' : 'text-stone-400 text-center py-8 text-xs' %>
  <turbo-stream action="append" target="trade_card_offers">
    <template>
      <p id="trade_card_offers_empty" class="<%= empty_classes %>">カード明細はまだありません</p>
    </template>
  </turbo-stream>
<% end %>

<turbo-stream action="replace" target="trade_aggregates">
  <template><%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_offer.trade }, formats: [:html]) %></template>
</turbo-stream>

<turbo-stream action="append" target="toast-container">
  <template><%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_offer.destroy', card_name: @trade_card_offer.card_name) }, formats: [:html]) %></template>
</turbo-stream>
