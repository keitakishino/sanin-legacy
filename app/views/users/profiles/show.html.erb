<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold text-stone-800 mb-6">登録情報</h1>

  <div class="bg-white border border-stone-200 rounded-lg p-6 space-y-6">
    <!-- ユーザー名 -->
    <div>
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-2">ユーザー名</h2>
      <p class="text-sm text-stone-800"><%= @user.username %></p>
    </div>

    <!-- メールアドレス -->
    <div>
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-2">メールアドレス</h2>
      <p class="text-sm text-stone-800"><%= @user.email.present? ? @user.email : "未設定" %></p>
    </div>

    <!-- 登録日 -->
    <div>
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-2">登録日</h2>
      <p class="text-sm text-stone-800"><%= @user.created_at.strftime("%Y年%m月%d日") %></p>
    </div>

    <!-- ロール -->
    <div>
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-2">ロール</h2>
      <p>
        <% if @user.role_admin? %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-danger-soft text-danger">管理者</span>
        <% else %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-neutral-soft text-stone-500">一般ユーザー</span>
        <% end %>
      </p>
    </div>

    <!-- 連携済み外部アカウント -->
    <div>
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-3">連携済み外部アカウント</h2>
      <% if @user.identities.any? %>
        <div class="space-y-2">
          <% @user.identities.each do |identity| %>
            <div class="flex items-center justify-between bg-stone-50 border border-stone-200 p-3 rounded-md">
              <span class="text-xs text-stone-800 font-medium"><%= identity.provider_display_name %></span>
              <% if identity.provider_twitter? && @twitter_identity %>
                <a href="https://twitter.com/intent/user?user_id=<%= @twitter_identity.uid %>" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover text-xs font-bold">
                  アカウントを表示
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-stone-400">連携済みのアカウントはありません</p>
      <% end %>
    </div>

    <!-- 連携可能な外部アカウント -->
    <div class="border-t border-stone-200 pt-4">
      <h2 class="text-xs font-bold text-stone-500 uppercase mb-3">新規連携</h2>
      <button type="button" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23 11a11 11 0 1 1-9.529-10.861A1 1 0 1 1 15.6 3.15a9 9 0 1 0 6.95 8.85 1 1 0 0 1 .45-1.973z"/>
        </svg>
        Googleで連携する
      </button>
    </div>
  </div>

  <!-- 編集ボタン -->
  <div class="mt-8 flex gap-4">
    <%= link_to "編集", edit_mypage_path, class: "px-6 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs" %>
  </div>
</div>
