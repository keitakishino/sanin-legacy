<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1 class="text-3xl font-bold mb-6">イベント一覧</h1>

  <% if @events.any? %>
    <div class="space-y-4">
      <% @events.each do |event| %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <%= link_to events_path(event),
              class: "block text-lg font-semibold text-blue-600 hover:text-blue-800",
              data: { turbo_frame: "event_modal" } do %>
            <div class="flex items-start justify-between">
              <div>
                <p class="text-lg font-semibold text-gray-800"><%= event.title %></p>
                <p class="text-sm text-gray-600 mt-2">
                  <%= event.event_date.strftime("%Y年%m月%d日") %>
                </p>
              </div>
              <span class="text-blue-600 hover:text-blue-800 font-semibold">詳細を表示</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg p-6 text-center">
      <p class="text-gray-500 text-lg">イベントはまだありません</p>
    </div>
  <% end %>

  <!-- Turbo Frame for modal content -->
  <turbo-frame id="event_modal" class="mt-8"></turbo-frame>
</div>
