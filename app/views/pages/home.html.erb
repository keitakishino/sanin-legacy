<div class="text-center">
  <h1 class="text-4xl font-bold mb-4">Welcome to Sanin Legacy</h1>
  <p class="text-lg text-gray-600 mb-8">Magic: The Gathering Card Trade Management</p>

  <% if user_signed_in? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
      <p>You are logged in as <strong><%= current_user.username %></strong></p>
    </div>
  <% else %>
    <div class="space-y-4">
      <p>
        <%= link_to "Sign In with Email", signin_path, class: "bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 inline-block" %>
      </p>
      <p>
        <%= button_to "Sign In with Google", "/auth/google", class: "bg-white border border-gray-300 text-gray-700 px-6 py-3 rounded-md hover:bg-gray-50 inline-block" %>
      </p>
      <p>
        <%= button_to "Sign In with X (Twitter)", "/auth/twitter", class: "bg-black text-white px-6 py-3 rounded-md hover:bg-gray-800 inline-block" %>
      </p>
    </div>
  <% end %>
</div>
