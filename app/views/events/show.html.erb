<turbo-frame id="event_modal">
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-96 overflow-y-auto">
      <!-- Header with close button -->
      <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex items-center justify-between sticky top-0">
        <h2 class="text-2xl font-bold text-gray-800"><%= @event.title %></h2>
        <button type="button" data-turbo-frame="event_modal"
                onclick="document.getElementById('event_modal').innerHTML = ''"
                class="text-gray-500 hover:text-gray-700 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="px-6 py-6 space-y-6">
        <!-- Event date -->
        <div>
          <h3 class="text-sm font-semibold text-gray-600 uppercase mb-2">開催日</h3>
          <p class="text-lg text-gray-800">
            <%= @event.event_date.strftime("%Y年%m月%d日") %>
          </p>
        </div>

        <!-- Description -->
        <div>
          <h3 class="text-sm font-semibold text-gray-600 uppercase mb-2">説明</h3>
          <% if @event.description.present? %>
            <p class="text-gray-700 whitespace-pre-wrap"><%= @event.description %></p>
          <% else %>
            <p class="text-gray-500">説明はありません</p>
          <% end %>
        </div>

        <!-- Created by -->
        <div>
          <h3 class="text-sm font-semibold text-gray-600 uppercase mb-2">作成者</h3>
          <p class="text-gray-800">
            <%= @event.created_by&.username %>
          </p>
        </div>

        <!-- Creation date -->
        <div>
          <h3 class="text-sm font-semibold text-gray-600 uppercase mb-2">作成日時</h3>
          <p class="text-gray-800">
            <%= @event.created_at.strftime("%Y年%m月%d日 %H:%M") %>
          </p>
        </div>
      </div>

      <!-- Footer with close button -->
      <div class="bg-gray-50 border-t border-gray-200 px-6 py-4 flex justify-end gap-2">
        <button type="button" data-turbo-frame="event_modal"
                onclick="document.getElementById('event_modal').innerHTML = ''"
                class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-semibold">
          閉じる
        </button>
      </div>
    </div>
  </div>
</turbo-frame>
