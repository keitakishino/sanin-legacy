<div id="<%= dom_id(trade_card_want) %>" class="bg-white rounded-lg p-6 border-l-[3px] border-emerald-700">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      <h3 class="text-lg font-semibold text-stone-800"><%= trade_card_want.card_name %></h3>
      <div class="mt-4 space-y-2 text-stone-600">
        <p><strong>数量:</strong> <%= trade_card_want.quantity %></p>
        <% if trade_card_want.language.present? %>
          <p><strong>言語:</strong> <%= I18n.t("activerecord.enums.trade_card_want.language.#{trade_card_want.language}") %></p>
        <% else %>
          <p><strong>言語:</strong> 不問</p>
        <% end %>
        <% if trade_card_want.conditions.present? && trade_card_want.conditions.any? %>
          <p><strong>状態:</strong> <%= trade_card_want.conditions.map { |c| I18n.t("activerecord.enums.trade_card_want_condition.#{c}") }.join(", ") %></p>
        <% else %>
          <p><strong>状態:</strong> 不問</p>
        <% end %>
        <% if trade_card_want.foil.present? %>
          <p><strong>フォイル:</strong> <%= I18n.t("activerecord.enums.trade_card_want.foil.#{trade_card_want.foil}") %></p>
        <% else %>
          <p><strong>フォイル:</strong> 不問</p>
        <% end %>
        <% if trade_card_want.frame.present? %>
          <p><strong>フレーム:</strong> <%= I18n.t("activerecord.enums.trade_card_want.frame.#{trade_card_want.frame}") %></p>
        <% else %>
          <p><strong>フレーム:</strong> 不問</p>
        <% end %>
        <% if trade_card_want.expansion %>
          <p><strong>セット:</strong> <%= trade_card_want.expansion.name %></p>
        <% end %>
        <% if trade_card_want.note.present? %>
          <p><strong>備考:</strong> <%= trade_card_want.note %></p>
        <% end %>
        <% if trade_card_want.amount.present? %>
          <p><strong>金額:</strong> ¥<%= number_with_delimiter(trade_card_want.amount) %></p>
        <% end %>
      </div>
    </div>
    <div class="flex gap-2 ml-4">
      <button
        type="button"
        class="px-3.5 py-1.5 bg-emerald-700 text-white text-xs font-medium rounded hover:bg-emerald-800"
        onclick="document.getElementById('<%= dom_id(trade_card_want, :edit_form) %>').style.display = 'block'">
        編集
      </button>
      <%= button_to "削除", trade_card_want_path(@trade.event, trade_card_want), method: :delete, form: { local: true, data: { turbo: true } }, class: "px-3.5 py-1.5 bg-white text-red-700 text-xs font-medium rounded hover:bg-red-50 border border-red-200" %>
    </div>
  </div>

  <!-- Edit form (hidden by default) -->
  <turbo-frame id="<%= dom_id(trade_card_want, :edit_form) %>" style="display: none;" class="mt-4 border-t border-stone-200 pt-4">
    <%= render 'form', trade_card_want: trade_card_want %>
  </turbo-frame>
</div>
