<% admin_context = @trade_id.present? %>
<% frame_id = admin_context ? 'new_trade_card_offer_admin' : 'new_trade_card_offer' %>

<turbo-stream action="append" target="trade_card_offers">
  <template><%= render 'trade_card_offer', trade_card_offer: @trade_card_offer %></template>
</turbo-stream>

<turbo-stream action="replace" target="<%= frame_id %>">
  <template>
    <turbo-frame id="<%= frame_id %>" style="display: none;" class="mt-4 bg-gray-50 p-4 rounded-lg">
      <%= render 'form', trade_card_offer: @trade.trade_card_offers.build, frame_id: frame_id %>
    </turbo-frame>
  </template>
</turbo-stream>
