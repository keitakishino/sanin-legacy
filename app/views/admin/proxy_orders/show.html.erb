<div class="container mx-auto px-4 py-4">
  <div class="mb-4">
    <%= link_to "← 戻る", admin_events_path, class: "link link-primary" %>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold"><%= @event.title %></h1>
    <p class="text-gray-600"><%= l(@event.event_date, format: :short) %></p>
  </div>

  <%= render "status" %>

  <div class="md:grid md:grid-cols-[minmax(0,1fr)_20rem] md:gap-6">
    <div>
      <%= render "fees" %>
      <%= render "items" %>
      <% if @proxy_order.details_editable? %>
        <%= render "new_item_form" %>
      <% end %>
      <%= render "participants" %>
    </div>

    <aside class="md:sticky md:top-4 md:self-start md:max-h-[calc(100vh-2rem)] md:overflow-y-auto">
      <%= render "summary" %>
    </aside>
  </div>
</div>

<div id="toast-container" class="fixed bottom-4 right-4 space-y-2 z-50"></div>
