<div class="bg-stone-50 w-full px-4 md:px-0 py-8">
  <!-- Header -->
  <div class="mb-8">
    <%= link_to "← 戻る", admin_events_path, class: "text-indigo-700 hover:text-indigo-800 mb-4 inline-block font-medium" %>
    <h1 class="text-3xl font-bold text-stone-800 mb-2"><%= @event.title %></h1>
    <div class="bg-indigo-50 p-4 rounded-lg border border-indigo-200 mb-4">
      <p class="text-stone-700 mb-2"><strong>ユーザー:</strong> <%= @trade.user.username %> (<%= @trade.user.email %>)</p>
      <p class="text-stone-600 text-sm">
        開催日: <%= @event.event_date.strftime("%Y年%m月%d日") %>
      </p>
    </div>
  </div>

  <!-- Error Messages -->
  <% if @trade.errors.any? %>
    <div id="trade_status_errors" class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
      <h3 class="text-red-800 font-semibold mb-2">エラーが発生しました</h3>
      <ul class="text-red-700 text-sm list-disc list-inside space-y-1">
        <% @trade.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Trade Status Section -->
  <div class="bg-white rounded-lg p-6 mb-8 border border-stone-200">
    <h2 class="text-lg font-semibold text-stone-800 mb-4">トレード状態管理</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%= render "status_display", trade: @trade %>
      <div>
        <%= form_with url: admin_event_trade_path(@event, @trade), method: :patch, model: @trade, local: true, class: "space-y-3" do |f| %>
          <div>
            <label for="trade_status" class="block text-sm font-semibold text-stone-800 mb-2">ステータス変更</label>
            <%= f.select :status,
              Trade.statuses.keys.map { |k| [I18n.t("activerecord.enums.trade.status.#{k}"), k] },
              { prompt: "選択してください", selected: @trade.status },
              id: "trade_status",
              class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <!-- Cancelled Reason (conditional) -->
          <div id="cancelled_reason_section" style="display: none;">
            <label for="trade_cancelled_reason" class="block text-sm font-semibold text-stone-800 mb-2">キャンセル理由</label>
            <%= f.text_area :cancelled_reason,
              id: "trade_cancelled_reason",
              rows: 3,
              class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <%= f.submit "更新", class: "px-4 py-2 bg-indigo-700 text-white rounded-lg hover:bg-indigo-800 font-semibold" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Aggregated Amounts Section -->
  <%= render "aggregates_section", trade: @trade %>

  <% can_create = @trade.card_detail_operation_allowed?(current_user, :create) %>

  <!-- Card Offers Section -->
  <div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
      <h2 class="text-2xl font-bold text-stone-800">出すカード一覧</h2>
      <%= render "trades/card_detail_list_controls", list: @offers_list %>
    </div>

    <div class="overflow-x-auto border border-stone-200 rounded-lg">
      <table class="w-full" id="trade_card_offers">
        <thead class="bg-stone-100">
          <tr>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500"><%= card_detail_sort_header(@offers_list, :card_name, "カード名") %></th>
            <th class="px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500 max-md:whitespace-nowrap"><span class="hidden md:inline"><%= card_detail_sort_header(@offers_list, :quantity, "数量") %></span><span class="md:hidden">数量</span></th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">言語</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">状態</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">フォイル</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">フレーム</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">PWマーク</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">セット</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">備考</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500"><%= card_detail_sort_header(@offers_list, :amount, "単価") %></th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">小計</th>
            <th class="md:hidden px-2 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-2 lg:px-4 py-3 text-right text-xs font-bold text-stone-500 max-md:whitespace-nowrap">操作</th>
          </tr>
        </thead>
        <% if @offers_list.records.any? %>
          <% @offers_list.records.each do |offer| %>
            <%= render "trade_card_offers/trade_card_offer", trade_card_offer: offer %>
          <% end %>
        <% else %>
          <tbody id="trade_card_offers_empty">
            <tr>
              <td colspan="13" class="px-4 py-8 text-center text-stone-500"><%= @offers_list.all_count.zero? ? "カード明細はまだありません" : "該当するカード明細はありません" %></td>
            </tr>
          </tbody>
        <% end %>
      </table>
    </div>

    <%= render "trades/card_detail_pager", list: @offers_list %>

    <% if can_create %>
      <div class="mt-4">
        <button
          type="button"
          class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold"
          id="add_offer_btn_admin">
          カード明細を追加
        </button>
      </div>

      <turbo-frame id="new_trade_card_offer_admin" style="display: none;" class="mt-4 bg-gray-50 p-4 rounded-lg" data-controller="form-reset">
        <%= render 'trade_card_offers/form', trade_card_offer: @trade.trade_card_offers.build, frame_id: 'new_trade_card_offer_admin' %>
      </turbo-frame>
    <% end %>
  </div>

  <!-- Card Wants Section -->
  <div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
      <h2 class="text-2xl font-bold text-stone-800">欲しいカード一覧</h2>
      <%= render "trades/card_detail_list_controls", list: @wants_list %>
    </div>

    <div class="overflow-x-auto border border-stone-200 rounded-lg">
      <table class="w-full" id="trade_card_wants">
        <thead class="bg-stone-100">
          <tr>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500"><%= card_detail_sort_header(@wants_list, :card_name, "カード名") %></th>
            <th class="px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500 max-md:whitespace-nowrap"><span class="hidden md:inline"><%= card_detail_sort_header(@wants_list, :quantity, "数量") %></span><span class="md:hidden">数量</span></th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">言語</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">状態</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">フォイル</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">フレーム</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">セット</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">備考</th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500"><%= card_detail_sort_header(@wants_list, :amount, "単価") %></th>
            <th class="hidden md:table-cell px-2 lg:px-4 py-3 text-left text-xs font-bold text-stone-500">小計</th>
            <th class="md:hidden px-2 py-3 text-left text-xs font-bold text-stone-500">カード名</th>
            <th class="px-2 lg:px-4 py-3 text-right text-xs font-bold text-stone-500 max-md:whitespace-nowrap">操作</th>
          </tr>
        </thead>
        <% if @wants_list.records.any? %>
          <% @wants_list.records.each do |want| %>
            <%= render "trade_card_wants/trade_card_want", trade_card_want: want %>
          <% end %>
        <% else %>
          <tbody id="trade_card_wants_empty">
            <tr>
              <td colspan="12" class="px-4 py-8 text-center text-stone-500"><%= @wants_list.all_count.zero? ? "カード明細はまだありません" : "該当するカード明細はありません" %></td>
            </tr>
          </tbody>
        <% end %>
      </table>
    </div>

    <%= render "trades/card_detail_pager", list: @wants_list %>

    <% if can_create %>
      <div class="mt-4">
        <button
          type="button"
          class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-semibold"
          id="add_want_btn_admin">
          カード明細を追加
        </button>
      </div>

      <turbo-frame id="new_trade_card_want_admin" style="display: none;" class="mt-4 bg-gray-50 p-4 rounded-lg" data-controller="form-reset">
        <%= render 'trade_card_wants/form', trade_card_want: @trade.trade_card_wants.build, frame_id: 'new_trade_card_want_admin' %>
      </turbo-frame>
    <% end %>
  </div>
</div>

<script>
  (() => {
    const statusSelect = document.getElementById('trade_status');
    const cancelledReasonSection = document.getElementById('cancelled_reason_section');

    function toggleCancelledReasonSection() {
      if (statusSelect) {
        if (statusSelect.value === 'cancelled') {
          cancelledReasonSection.style.display = 'block';
        } else {
          cancelledReasonSection.style.display = 'none';
        }
      }
    }

    if (statusSelect) {
      statusSelect.addEventListener('change', toggleCancelledReasonSection);
    }

    // Initialize immediately and on page load
    toggleCancelledReasonSection();
    document.addEventListener('DOMContentLoaded', toggleCancelledReasonSection);

    // Toggle forms for admin line item operations
    const addOfferBtnAdmin = document.getElementById('add_offer_btn_admin');
    if (addOfferBtnAdmin) {
      addOfferBtnAdmin.addEventListener('click', function() {
        const frame = document.getElementById('new_trade_card_offer_admin');
        frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
      });
    }

    const addWantBtnAdmin = document.getElementById('add_want_btn_admin');
    if (addWantBtnAdmin) {
      addWantBtnAdmin.addEventListener('click', function() {
        const frame = document.getElementById('new_trade_card_want_admin');
        frame.style.display = frame.style.display === 'none' ? 'block' : 'none';
      });
    }

    // Mobile accordion expansion (delegated so rows appended/replaced by Turbo Streams work too).
    // Registered once: this inline script re-runs on every Turbo visit.
    if (!window.tradeCardExpandDelegated) {
      window.tradeCardExpandDelegated = true;
      document.addEventListener('click', function(e) {
        const button = e.target.closest('[data-toggle-expand]');
        if (!button) return;
        const table = button.closest('#trade_card_offers') || button.closest('#trade_card_wants');
        if (!table) return;
        e.preventDefault();
        const rowId = button.getAttribute('data-toggle-expand');
        const expandRow = document.getElementById('expand_' + rowId);
        if (!expandRow) return;
        const isHidden = expandRow.style.display === 'none';
        table.querySelectorAll('tr[id^="expand_"]').forEach(row => { row.style.display = 'none'; });
        table.querySelectorAll('tr[id^="edit_form_"]').forEach(row => { row.style.display = 'none'; });
        table.querySelectorAll('[data-toggle-expand]').forEach(btn => { btn.setAttribute('aria-expanded', 'false'); });
        if (isHidden) {
          expandRow.style.display = 'table-row';
          button.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Also listen for turbo:load for full page navigation
    document.addEventListener('turbo:load', function() {
      document.querySelectorAll('tr[id^="expand_"]').forEach(row => {
        row.style.display = 'none';
      });
      document.querySelectorAll('tr[id^="edit_form_"]').forEach(row => {
        row.style.display = 'none';
      });
    });

    // Hide expand buttons on desktop
    function updateExpandButtonVisibility() {
      const buttons = document.querySelectorAll('[data-toggle-expand]');
      const isDesktop = window.innerWidth >= 768;
      buttons.forEach(btn => {
        btn.style.display = isDesktop ? 'none' : 'inline-block';
      });
    }
    updateExpandButtonVisibility();
    window.addEventListener('resize', updateExpandButtonVisibility);
  })();
</script>
