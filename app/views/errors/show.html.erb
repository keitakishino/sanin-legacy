<div class="bg-surface border border-border rounded-[10px] p-8 text-center shadow-sm">
  <div class="mb-6">
    <div class="text-6xl font-bold text-text mb-4"><%= @status_code %></div>
    <h1 class="text-2xl font-bold text-text mb-4"><%= @title %></h1>
    <p class="text-text-secondary mb-0"><%= @message %></p>
  </div>

  <div class="mt-8">
    <%= link_to t("errors.button", default: "ホームに戻る"), @button_path, class: "inline-block px-6 py-3 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-sm transition-colors" %>
  </div>
</div>
