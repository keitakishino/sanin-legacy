<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-stone-800 mb-4"><%= t("dashboards.show.title") %></h1>
    <p class="text-stone-500 text-sm">
      <%= t("dashboards.show.subtitle") %>
    </p>
  </div>

  <!-- Incomplete Trades Section with Turbo Frame (Lazy Loading) -->
  <turbo-frame id="incomplete_trades" src="<%= dashboards_incomplete_trades_path %>" loading="lazy"></turbo-frame>

  <!-- My Proxy Orders Section -->
  <section id="my_proxy_orders" class="mt-8">
    <h2 class="text-2xl font-bold text-stone-800 mb-4"><%= t("dashboards.show.proxy_orders_title") %></h2>

    <% if @my_proxy_orders.any? %>
      <div class="space-y-4">
        <% @my_proxy_orders.each do |proxy_order| %>
          <%= link_to proxy_order_path(proxy_order.event_id), id: dom_id(proxy_order, :dashboard), class: "block bg-white border border-stone-200 rounded-[10px] p-6 hover:shadow-md transition-shadow no-underline text-inherit" do %>
            <div class="flex justify-between items-start gap-4">
              <div>
                <p class="text-lg font-bold text-stone-800 mb-2"><%= proxy_order.event.title %></p>
                <p class="text-xs text-stone-500 mb-4"><%= t("admin.proxy_order.event_date", date: l(proxy_order.event.event_date.to_date, format: :long)) %></p>
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold <%= proxy_order.ordered? ? 'bg-neutral-soft text-stone-500' : 'bg-warning-soft text-warning' %>">
                  <%= t("activerecord.enums.proxy_order.status.#{proxy_order.status}") %>
                </span>
              </div>
              <div class="text-right">
                <p class="m-0 text-[11px] font-bold text-stone-400">
                  <%= proxy_order.ordered? ? "#{t('dashboards.show.payment_amount')}（#{t('dashboards.show.provisional')}）" : t("dashboards.show.payment_amount") %>
                </p>
                <p class="mt-1 mb-2 text-2xl font-extrabold tabular-nums text-emerald-700"><%= jpy_or_pending(@my_proxy_order_payments[proxy_order.id]) %></p>
                <span class="text-xs font-bold text-accent"><%= t("dashboards.show.view_details") %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render "dashboards/empty_state", message: t("dashboards.show.no_proxy_orders_message"), guidance: t("dashboards.show.no_proxy_orders_guidance") %>
    <% end %>
  </section>

  <!-- Navigation -->
  <div class="mt-8 pt-8 border-t border-stone-200">
    <%= link_to t("dashboards.show.view_events"), events_path,
        class: "text-accent hover:text-accent-hover font-bold text-sm" %>
  </div>
</div>
