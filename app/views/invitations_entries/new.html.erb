<div class="bg-stone-50 min-h-screen flex items-center justify-center">
  <div class="bg-white border border-stone-200 rounded-lg p-8 max-w-xs w-full">
    <h2 class="text-2xl font-bold text-stone-800 mb-6">招待コードの入力</h2>

    <% if flash.now[:alert] %>
      <div class="mb-4 p-4 bg-danger-soft border border-danger rounded-md">
        <p class="text-danger text-sm font-semibold"><%= flash.now[:alert] %></p>
      </div>
    <% end %>

    <%= form_with model: @invitation, url: "/invite", local: true do |f| %>
      <div class="mb-4">
        <%= f.label :code, "招待コード", class: "block text-xs font-bold text-stone-500 mb-2" %>
        <%= f.text_field :code, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", placeholder: "招待コードを入力してください", required: true %>
      </div>

      <div>
        <%= f.submit "続行", class: "w-full bg-accent text-white px-4 py-2 rounded-md hover:bg-accent-hover font-bold text-xs" %>
      </div>
    <% end %>
  </div>
</div>
