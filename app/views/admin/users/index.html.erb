<div class="py-8">
  <h2 class="text-3xl font-bold mb-6"><%= t("admin.users.title") %></h2>

  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <h3 class="text-xl font-semibold mb-4"><%= t("admin.users.search_placeholder") %></h3>

    <%= form_with url: admin_users_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :q, placeholder: t("admin.users.search_placeholder"), value: params[:q], class: "flex-1 px-4 py-2 border rounded" %>
        <%= f.submit t("admin.users.search_button"), class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>

  <turbo-frame id="users_list" class="block">
    <%= render "users_list", users: @users %>
  </turbo-frame>
</div>
