<turbo-frame id="expansion_suggestions">
  <% if @expansions.any? %>
    <div class="divide-y divide-stone-200">
      <% @expansions.each do |expansion| %>
        <div class="px-4 py-3 hover:bg-stone-50 cursor-pointer transition"
             data-expansion-code="<%= expansion.scryfall_set_code %>"
             data-expansion-id="<%= expansion.id %>"
             data-action="click->expansion-select#selectExpansion">
          <div class="flex items-baseline gap-3">
            <%= highlight_set_code(expansion.scryfall_set_code, @query) %>
            <span class="text-stone-700"><%= expansion.name %></span>
            <% if expansion.name_ja.present? %>
              <span class="text-xs text-stone-500"><%= expansion.name_ja %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
