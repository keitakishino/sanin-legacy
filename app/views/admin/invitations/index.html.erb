<div class="bg-stone-50 py-8">
  <h2 class="text-3xl font-bold mb-6 text-stone-800"><%= t("admin.invitations.title") %></h2>

  <div id="invitation_form_success"></div>
  <div id="invitation_form_error"></div>

  <div class="bg-white border border-stone-200 rounded-lg p-6 mb-8">
    <h3 class="text-xl font-semibold mb-4 text-stone-800"><%= t("admin.invitations.new_code_section") %></h3>

    <%= form_with model: @invitation, local: true, url: admin_invitations_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.submit t("admin.invitations.generate_button"), class: "bg-indigo-700 text-white px-4 py-2 rounded hover:bg-indigo-800 font-medium" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
    <h3 class="text-xl font-semibold p-6 border-b border-stone-200 text-stone-800"><%= t("admin.invitations.issued_codes_list") %></h3>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-stone-100 border-b border-stone-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.code") %></th>
            <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.status") %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.expires_at") %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.issued_by_id") %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.used_by_id") %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("activerecord.attributes.invitation.created_at") %></th>
            <th class="px-6 py-3 text-right text-xs font-bold text-stone-500"></th>
          </tr>
        </thead>
        <tbody id="invitations">
          <% @invitations.each do |invitation| %>
            <%= render "invitation", invitation: invitation %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // Mobile accordion expansion
    function setupExpandButtons() {
      document.querySelectorAll('[data-toggle-expand]').forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          const rowId = this.getAttribute('data-toggle-expand');
          const expandRow = document.getElementById('expand_' + rowId);

          if (expandRow) {
            const isHidden = expandRow.style.display === 'none';
            // Close all other expand rows in the same table
            const table = this.closest('table');
            table.querySelectorAll('[id^="expand_"]').forEach(row => {
              row.style.display = 'none';
            });
            table.querySelectorAll('[data-toggle-expand]').forEach(btn => {
              btn.setAttribute('aria-expanded', 'false');
            });

            // Toggle this row
            if (isHidden) {
              expandRow.style.display = 'table-row';
              this.setAttribute('aria-expanded', 'true');
            }
          }
        });
      });
    }

    setupExpandButtons();

    // Listen for Turbo Stream updates to re-bind accordion buttons
    document.addEventListener('turbo:before-stream-render', function() {
      // Clear old button listeners before DOM update
      document.querySelectorAll('[data-toggle-expand]').forEach(button => {
        const newButton = button.cloneNode(true);
        button.parentNode.replaceChild(newButton, button);
      });
    });

    document.addEventListener('turbo:after-stream-render', function() {
      // Reset all expand rows to hidden after DOM update
      document.querySelectorAll('[id^="expand_"]').forEach(row => {
        row.style.display = 'none';
      });

      // Re-setup expand buttons
      setupExpandButtons();
    });

    // Also listen for turbo:load for full page navigation
    document.addEventListener('turbo:load', function() {
      document.querySelectorAll('[data-toggle-expand]').forEach(button => {
        const newButton = button.cloneNode(true);
        button.parentNode.replaceChild(newButton, button);
      });

      document.querySelectorAll('[id^="expand_"]').forEach(row => {
        row.style.display = 'none';
      });

      setupExpandButtons();
    });

    // Hide expand buttons on desktop
    function updateExpandButtonVisibility() {
      const buttons = document.querySelectorAll('[data-toggle-expand]');
      const isDesktop = window.innerWidth >= 768;
      buttons.forEach(btn => {
        btn.style.display = isDesktop ? 'none' : 'inline-block';
      });
    }
    updateExpandButtonVisibility();
    window.addEventListener('resize', updateExpandButtonVisibility);
  </script>
</div>
