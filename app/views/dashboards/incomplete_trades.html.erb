<turbo-frame id="incomplete_trades">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-stone-800 mb-6"><%= t("dashboards.show.incomplete_trades_title") %></h2>

    <% if @incomplete_trades.any? %>
      <div class="space-y-4">
        <% @incomplete_trades.each do |trade| %>
          <div class="bg-white border border-stone-200 rounded-[10px] p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <!-- Event and Trade Info -->
                <p class="text-lg font-bold text-stone-800 mb-2">
                  <%= trade.event.title %>
                </p>
                <p class="text-xs text-stone-500 mb-4">
                  <%= t("dashboards.show.event_date_label") %>: <%= trade.event.event_date.strftime("%Y年%m月%d日") %>
                </p>

                <!-- Status Badge -->
                <div class="mb-4">
                  <% case trade.status
                     when "pending"
                       badge_bg = "bg-neutral-soft"
                       badge_text = "text-stone-500"
                     when "in_progress"
                       badge_bg = "bg-warning-soft"
                       badge_text = "text-warning"
                     when "completed"
                       badge_bg = "bg-success-soft"
                       badge_text = "text-success"
                     when "cancelled"
                       badge_bg = "bg-danger-soft"
                       badge_text = "text-danger"
                     else
                       badge_bg = "bg-neutral-soft"
                       badge_text = "text-stone-500"
                     end %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-bold <%= badge_bg %> <%= badge_text %>">
                    <%= I18n.t("activerecord.enums.trade.status.#{trade.status}") %>
                  </span>
                </div>

                <!-- Aggregates -->
                <div class="grid grid-cols-3 gap-4 text-xs">
                  <div>
                    <p class="text-stone-400 text-xs uppercase font-bold"><%= t("dashboards.show.offers_total") %></p>
                    <p class="text-lg font-bold text-stone-800 mt-1"><%= number_with_delimiter(trade.offers_total_amount) %> <%= t("dashboards.show.yen") %></p>
                  </div>
                  <div>
                    <p class="text-stone-400 text-xs uppercase font-bold"><%= t("dashboards.show.wants_total") %></p>
                    <p class="text-lg font-bold text-stone-800 mt-1"><%= number_with_delimiter(trade.wants_total_amount) %> <%= t("dashboards.show.yen") %></p>
                  </div>
                  <div>
                    <p class="text-stone-400 text-xs uppercase font-bold"><%= t("dashboards.show.net_amount") %></p>
                    <% net_class = trade.net_amount >= 0 ? "text-success" : "text-danger" %>
                    <p class="text-lg font-bold <%= net_class %> mt-1">
                      <%= number_with_delimiter(trade.net_amount) %> <%= t("dashboards.show.yen") %>
                    </p>
                  </div>
                </div>
              </div>

              <!-- Action Link -->
              <div class="ml-4">
                <%= link_to t("dashboards.show.view_details"), trade_path(trade.event_id),
                    class: "px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover font-bold text-xs whitespace-nowrap" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-stone-50 rounded-lg p-8 text-center">
        <p class="text-stone-500 text-lg mb-4"><%= t("dashboards.show.no_trades_message") %></p>
        <p class="text-stone-500 text-sm mb-6">
          <%= t("dashboards.show.no_trades_guidance") %>
        </p>
        <%= link_to t("dashboards.show.view_events"), events_path,
            class: "text-accent hover:text-accent-hover font-bold text-sm" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
