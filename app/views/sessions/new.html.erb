<div class="bg-stone-50 min-h-screen flex items-center justify-center -mx-4 -my-8">
  <div class="bg-white border border-stone-200 rounded-lg p-8 max-w-xs w-full">
    <h2 class="text-2xl font-bold text-stone-800 mb-6">サインイン</h2>

    <%= form_with url: "/signin", local: true do |f| %>
      <div class="mb-4">
        <%= f.label :email, "メールアドレス", class: "block text-xs font-bold text-stone-500 mb-2" %>
        <%= f.email_field :email, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "パスワード", class: "block text-xs font-bold text-stone-500 mb-2" %>
        <%= f.password_field :password, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent", required: true %>
      </div>

      <div class="mb-4">
        <%= f.submit "サインイン", class: "w-full bg-accent text-white px-4 py-2 rounded-md hover:bg-accent-hover font-bold text-xs" %>
      </div>
    <% end %>

    <div class="flex items-center gap-2 my-4"><hr class="flex-1 border-stone-200"><span class="text-xs text-stone-400">または</span><hr class="flex-1 border-stone-200"></div>

    <div class="space-y-3">
      <%= button_to "/auth/google", method: :post, data: { turbo: false }, class: "w-full flex items-center justify-center gap-2 px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs" do %>
        <svg viewBox="0 0 48 48" class="w-4 h-4" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l8.02 6.21c1.91-5.08 6.9-8.93 12.42-8.93z"></path>
          <path fill="#4285F4" d="M23.99 44.5c6.47 0 11.9-2.38 15.89-6.84l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.52 0-12-4.85-13.89-11.6H2.18v6.19C6.43 39.12 14.13 44.5 23.99 44.5z"></path>
          <path fill="#FBBC05" d="M10.1 27.06c-.54-1.45-.86-2.99-.86-4.56 0-1.57.32-3.11.86-4.56l-8.04-6.24c-1.81 3.61-2.85 7.57-2.85 11.8s1.04 8.19 2.85 11.8l8.04-6.24z"></path>
          <path fill="#34A853" d="M24 10a14.8 14.8 0 0 1 14.34 9.16l7.73-6c-2.59-3.89-7.27-6.86-13.61-8.16v8z"></path>
        </svg>
        <span>Google でサインイン</span>
      <% end %>

      <%= button_to "/auth/discord", method: :post, data: { turbo: false }, class: "w-full flex items-center justify-center gap-2 px-4 py-2 bg-white border border-stone-300 text-stone-800 rounded-md hover:bg-stone-50 font-bold text-xs" do %>
        <svg viewBox="0 0 127.14 96.36" class="w-4 h-4" aria-hidden="true" fill="#5865F2">
          <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.38 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21h0A105.73 105.73 0 0 0 32.71 96.36a72.04 72.04 0 0 0 5.89-6.5 68.11 68.11 0 0 1-10-1.29c.83-.6 1.64-1.24 2.42-1.93.2-.16.4-.32.59-.48a77.15 77.15 0 0 0 64.32 0c.2.16.39.32.58.48.78.69 1.59 1.33 2.42 1.93a68.11 68.11 0 0 1-10 1.29 72 72 0 0 0 5.89 6.5A105.73 105.73 0 0 0 126.6 80.22h0c2.24-23.61-1.7-47.56-7.9-71.15zM42.45 65.69C36.66 65.69 32 60.6 32 54s4.66-11.67 10.45-11.67c5.78 0 10.45 5.22 10.45 11.67s-4.67 11.69-10.45 11.69zm42.24 0c-5.79 0-10.45-5.22-10.45-11.67s4.66-11.67 10.45-11.67c5.79 0 10.45 5.22 10.45 11.67s-4.66 11.69-10.45 11.69z"></path>
        </svg>
        <span>Discord でサインイン</span>
      <% end %>
    </div>

    <div class="mt-4 text-center text-sm">
      <%= link_to "初めてご利用の方は招待コードの入力へ", "/invite", class: "text-accent hover:text-accent-hover font-bold" %>
    </div>
  </div>
</div>
