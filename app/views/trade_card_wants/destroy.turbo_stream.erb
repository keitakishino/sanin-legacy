<%= turbo_stream.remove dom_id(@trade_card_want, :group) %>

<% if @trade_card_want.trade.trade_card_wants.count == 0 %>
  <%= turbo_stream.append "trade_card_wants" do %>
    <tbody id="trade_card_wants_empty">
      <tr>
        <td colspan="11" class="px-4 py-8 text-center text-stone-400 text-xs">カード明細はまだありません</td>
      </tr>
    </tbody>
  <% end %>
<% end %>

<%= turbo_stream.replace "trade_aggregates" do %>
  <%= render(partial: 'trades/aggregates_inline', locals: { trade: @trade_card_want.trade }, formats: [:html]) %>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <%= render(partial: 'shared/toast', locals: { message: t('toasts.trade_card_want.destroy', card_name: @trade_card_want.card_name) }, formats: [:html]) %>
<% end %>
