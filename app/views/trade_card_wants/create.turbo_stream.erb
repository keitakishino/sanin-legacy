<turbo-stream action="append" target="trade_card_wants">
  <template><%= render 'trade_card_wants/trade_card_want', trade_card_want: @trade_card_want %></template>
</turbo-stream>

<turbo-stream action="replace" target="new_trade_card_want">
  <template>
    <turbo-frame id="new_trade_card_want" style="display: none;" class="mt-4 bg-gray-50 p-4 rounded-lg">
      <%= render 'trade_card_wants/form', trade_card_want: @trade.trade_card_wants.build %>
    </turbo-frame>
  </template>
</turbo-stream>
