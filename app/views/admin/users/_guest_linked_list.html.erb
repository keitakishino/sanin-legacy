<div id="guest_linked_list" class="mt-6">
  <h4 class="text-sm font-bold text-stone-800 mb-2"><%= t("admin.users.guest_link.linked_title") %></h4>

  <% if groups.empty? %>
    <p class="text-sm text-stone-500"><%= t("admin.users.guest_link.linked_empty") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-stone-100 border-b border-stone-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_name") %></th>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_orders") %></th>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_count") %></th>
            <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_action") %></th>
          </tr>
        </thead>
        <tbody>
          <% groups.each_with_index do |group, i| %>
            <tr id="guest_linked_row_<%= i %>" class="border-b border-stone-200">
              <td class="px-4 py-3"><%= group.guest_names.join(" / ") %></td>
              <td class="px-4 py-3 text-sm">
                <%= group.order_titles.first(3).join("、") %><% if group.order_titles.size > 3 %><%= t("admin.users.guest_link.more_orders", count: group.order_titles.size - 3) %><% end %>
              </td>
              <td class="px-4 py-3 text-sm">
                <%= t("admin.users.guest_link.count_value", count: group.count) %>
              </td>
              <td class="px-4 py-3">
                <%= link_to t("admin.users.guest_link.unlink_button"), new_admin_user_guest_unlink_path(user, name_key: group.normalized_name), data: { turbo_frame: "guest_link_modal" }, class: "inline-block px-3 py-1.5 bg-white text-red-700 border border-red-300 rounded-md hover:bg-red-50 font-bold text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
