<turbo-stream action="replace" target="<%= dom_id(@trade_card_want, :edit_form) %>">
  <template>
    <turbo-frame id="<%= dom_id(@trade_card_want, :edit_form) %>" class="mt-4 border-t pt-4">
      <%= render 'form', trade_card_want: @trade_card_want %>
    </turbo-frame>
  </template>
</turbo-stream>

<% if @trade_card_want.errors.any? %>
  <turbo-stream action="append" target="toast-container">
    <template><%= render(partial: "shared/toast", locals: { message: @trade_card_want.errors.full_messages.join(", "), variant: :danger }, formats: [:html]) %></template>
  </turbo-stream>
<% end %>
