<tr id="<%= dom_id(trade_card_want) %>" class="border-b border-stone-200 hover:bg-stone-50" style="border-left: 3px solid oklch(52% 0.1 150)">
  <!-- Desktop: Full columns -->
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800 truncate" title="<%= trade_card_want.card_name %>"><%= trade_card_want.card_name %></td>
  <td class="px-4 py-3 text-sm text-stone-800"><%= trade_card_want.quantity %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.language.present? ? I18n.t("activerecord.enums.trade_card_want.language.#{trade_card_want.language}") : "不問" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.conditions.present? && trade_card_want.conditions.any? ? trade_card_want.conditions.map { |c| I18n.t("activerecord.enums.trade_card_want_condition.#{c}") }.join(", ") : "不問" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.foil.present? ? I18n.t("activerecord.enums.trade_card_want.foil.#{trade_card_want.foil}") : "不問" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.frame.present? ? I18n.t("activerecord.enums.trade_card_want.frame.#{trade_card_want.frame}") : "不問" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.expansion&.name.present? ? trade_card_want.expansion.name : "—" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800 truncate" title="<%= trade_card_want.note %>"><%= trade_card_want.note.present? ? trade_card_want.note : "—" %></td>
  <td class="hidden md:table-cell px-4 py-3 text-sm text-stone-800"><%= trade_card_want.amount.present? ? "¥#{number_with_delimiter(trade_card_want.amount)}" : "—" %></td>

  <!-- Mobile: Card name only -->
  <td class="md:hidden px-4 py-3 text-sm text-stone-800 flex-1 truncate" title="<%= trade_card_want.card_name %>"><%= trade_card_want.card_name %></td>

  <!-- Actions -->
  <td class="px-4 py-3 text-right">
    <div class="flex items-center justify-end gap-2">
      <button
        type="button"
        class="px-2 py-1 text-emerald-700 hover:bg-emerald-50 text-xs rounded hover:opacity-90 font-bold"
        onclick="document.getElementById('<%= dom_id(trade_card_want, :edit_form) %>').style.display = 'table-row'; document.getElementById('<%= dom_id(trade_card_want, :expand) %>').classList.add('hidden');">
        編集
      </button>
      <%= button_to "削除", trade_card_want_path(@trade.event, trade_card_want), method: :delete, form: { local: true, data: { turbo: true } }, class: "px-2 py-1 text-red-700 hover:bg-red-50 text-xs rounded hover:opacity-90 font-bold" %>
      <button
        type="button"
        class="md:hidden px-2 py-1 text-stone-500 hover:bg-stone-100 text-xs"
        data-toggle-expand="<%= dom_id(trade_card_want) %>"
        aria-expanded="false">
        ▼
      </button>
    </div>
  </td>
</tr>

<!-- Mobile expansion row -->
<tr id="<%= dom_id(trade_card_want, :expand) %>" class="hidden md:table-row border-b border-stone-200" style="border-left: 3px solid oklch(52% 0.1 150); display: table-row;">
  <td colspan="3" class="px-4 py-3 bg-stone-50">
    <div class="space-y-2 text-sm">
      <p><strong>言語:</strong> <%= trade_card_want.language.present? ? I18n.t("activerecord.enums.trade_card_want.language.#{trade_card_want.language}") : "不問" %></p>
      <p><strong>状態:</strong> <%= trade_card_want.conditions.present? && trade_card_want.conditions.any? ? trade_card_want.conditions.map { |c| I18n.t("activerecord.enums.trade_card_want_condition.#{c}") }.join(", ") : "不問" %></p>
      <p><strong>フォイル:</strong> <%= trade_card_want.foil.present? ? I18n.t("activerecord.enums.trade_card_want.foil.#{trade_card_want.foil}") : "不問" %></p>
      <p><strong>フレーム:</strong> <%= trade_card_want.frame.present? ? I18n.t("activerecord.enums.trade_card_want.frame.#{trade_card_want.frame}") : "不問" %></p>
      <% if trade_card_want.expansion %>
        <p><strong>セット:</strong> <%= trade_card_want.expansion.name %></p>
      <% end %>
      <% if trade_card_want.note.present? %>
        <p><strong>備考:</strong> <%= trade_card_want.note %></p>
      <% end %>
      <% if trade_card_want.amount.present? %>
        <p><strong>金額:</strong> ¥<%= number_with_delimiter(trade_card_want.amount) %></p>
      <% end %>
    </div>
  </td>
</tr>

<!-- Edit form row (hidden by default) -->
<tr id="<%= dom_id(trade_card_want, :edit_form) %>" class="hidden border-b border-stone-200" style="border-left: 3px solid oklch(52% 0.1 150)">
  <td colspan="11" class="px-4 py-4 bg-stone-50">
    <turbo-frame id="<%= dom_id(trade_card_want, :edit_form) %>" class="">
      <%= render 'trade_card_wants/form', trade_card_want: trade_card_want, frame_id: dom_id(trade_card_want, :edit_form) %>
    </turbo-frame>
  </td>
</tr>
