<div id="proxy_order_summary" class="bg-white border border-stone-200 rounded-lg">
  <div class="p-6">
    <h2 class="text-lg font-bold text-stone-800 mb-4"><%= t("admin.proxy_order.payment_summary") %></h2>

    <div class="mb-6 p-4 bg-stone-50 border border-stone-200 rounded-md">
      <div class="flex justify-between mb-2 text-sm">
        <span class="text-stone-600"><%= t("admin.proxy_order.total_fees") %></span>
        <strong class="text-stone-800"><%= usd(@calculator.fee_total) %></strong>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-stone-600"><%= t("admin.proxy_order.fee_per_person") %></span>
        <strong id="proxy_order_fee_per_person" class="text-stone-800"><%= usd(@calculator.fee_per_person) %></strong>
      </div>
    </div>

    <div class="space-y-4">
      <% @participants.each do |participant| %>
        <div id="<%= dom_id(participant, :summary) %>" class="p-4 bg-stone-50 border border-stone-200 rounded-md">
          <div class="font-bold text-sm text-stone-800 mb-2">
            <%= participant_display_name(participant) %>
            <% if !@proxy_order.ordered? && participant.handed_over_at.present? %>
              <span data-role="handed-over" class="text-xs font-normal text-success"><%= t("admin.proxy_order.handed_over") %></span>
            <% elsif !@proxy_order.ordered? && participant.handed_over_at.nil? %>
              <span data-role="handed-over" class="text-xs font-normal text-danger"><%= t("admin.proxy_order.not_handed_over") %></span>
            <% end %>
          </div>
          <div class="space-y-1 text-sm">
            <div class="flex justify-between">
              <span class="text-stone-600"><%= t("admin.proxy_order.goods_total") %></span>
              <span data-role="goods-total" class="text-stone-800"><%= usd(@calculator.goods_total(participant)) %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-stone-600"><%= t("admin.proxy_order.fee") %></span>
              <span data-role="fee" class="text-stone-800"><%= usd(@calculator.fee_for(participant)) %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-stone-600"><%= t("admin.proxy_order.payment_usd") %></span>
              <span data-role="payment-usd" class="text-stone-800"><%= usd(@calculator.payment_usd(participant)) %></span>
            </div>
            <div class="flex justify-between border-t border-stone-200 pt-1 mt-1">
              <strong class="text-stone-800"><%= t("admin.proxy_order.payment_jpy") %></strong>
              <strong data-role="payment-jpy" class="text-stone-800"><%= jpy_or_pending(@calculator.payment_jpy(participant)) %></strong>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
