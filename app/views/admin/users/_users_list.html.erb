<% if users.empty? %>
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <p class="text-stone-500"><%= t("admin.users.no_users") %></p>
  </div>
<% else %>
  <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
    <table class="w-full">
      <thead class="bg-stone-100 border-b border-stone-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.username") %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.email") %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.role") %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.registered_at") %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.view_details") %></th>
        </tr>
      </thead>
      <tbody id="users">
        <% users.each do |user| %>
          <tr class="border-b border-stone-200 hover:bg-stone-50 cursor-pointer" data-controller="clickable-row" data-action="click->clickable-row#click" data-url="<%= admin_user_path(user) %>">
            <td class="px-6 py-4 text-sm"><%= user.username %></td>
            <td class="hidden md:table-cell px-6 py-4 text-sm"><%= user.email || "－" %></td>
            <td class="px-6 py-4 text-sm">
              <% if user.role_admin? %>
                <span class="bg-red-50 text-red-700 px-3 py-1 rounded text-xs font-semibold"><%= t("admin.users.admin_label") %></span>
              <% else %>
                <span class="bg-stone-100 text-stone-500 px-3 py-1 rounded text-xs font-semibold"><%= t("admin.users.general") %></span>
              <% end %>
            </td>
            <td class="hidden md:table-cell px-6 py-4 text-sm"><%= user.created_at.strftime("%Y年%m月%d日") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
