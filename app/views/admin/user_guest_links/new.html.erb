<turbo-frame id="guest_link_modal">
  <div class="fixed inset-0 bg-black/55 flex items-center justify-center p-4 z-50">
    <div class="bg-white border border-stone-200 rounded-lg max-w-3xl w-full max-h-[90vh] overflow-y-auto flex flex-col">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-stone-200 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-stone-800"><%= t("admin.users.guest_link.modal_title") %></h2>
          <p class="text-xs text-stone-500"><%= t("admin.users.guest_link.target_user", username: @user.username) %></p>
        </div>
        <button type="button" aria-label="<%= t("admin.users.guest_link.close") %>" onclick="document.getElementById('guest_link_modal').innerHTML = ''" class="text-stone-400 hover:text-stone-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Search form -->
      <div class="px-6 py-4 border-b border-stone-200">
        <%= form_with url: new_admin_user_guest_link_path(@user), method: :get, id: "guest_link_search_form" do |f| %>
          <div>
            <%= label_tag :q, t("admin.users.guest_link.search_label"), for: "guest_link_q", class: "block text-xs font-bold text-stone-500 mb-1" %>
            <%= text_field_tag :q, @q, id: "guest_link_q", class: "w-full px-3 py-2 border border-stone-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-accent" %>
          </div>
          <div class="mt-3">
            <%= submit_tag t("admin.users.guest_link.search_button"), name: nil, class: "px-3 py-1.5 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs" %>
          </div>
        <% end %>
      </div>

      <!-- Error box -->
      <% if @errors.present? %>
        <div id="guest_link_errors" class="px-6 py-4 bg-red-50 border-b border-red-200">
          <ul class="list-disc list-inside space-y-1 text-red-700 text-sm">
            <% @errors.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
          <p class="text-xs text-red-700 mt-2"><%= t("admin.users.guest_link.conflict_hint") %></p>
        </div>
      <% end %>

      <!-- Results -->
      <div class="px-6 py-4 flex-grow overflow-y-auto">
        <% if @too_many %>
          <p id="guest_link_too_many" class="text-sm text-stone-600"><%= t("admin.users.guest_link.too_many") %></p>
        <% elsif @candidates.empty? %>
          <p class="text-sm text-stone-500"><%= t("admin.users.guest_link.empty") %></p>
        <% else %>
          <p class="text-xs text-stone-500 mb-4"><%= t("admin.users.guest_link.results_count", count: @candidates.size) %></p>

          <%= form_with url: admin_user_guest_link_path(@user), method: :post, id: "guest_link_form", local: true, html: { class: "group", onchange: "document.getElementById('guest_link_submit').disabled = !this.querySelector('input[name=guest_name_key]:checked')" } do |f| %>
            <%= hidden_field_tag :q, @q %>

            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-stone-100 border-b border-stone-200">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"></th>
                    <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_name") %></th>
                    <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_orders") %></th>
                    <th class="px-4 py-3 text-left text-xs font-bold text-stone-500"><%= t("admin.users.guest_link.column_count") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @candidates.each_with_index do |c, i| %>
                    <tr id="guest_link_candidate_row_<%= i %>" class="border-b border-stone-200 has-[:checked]:bg-indigo-50 <%= c.selectable? ? '' : 'bg-stone-50 text-stone-400' %>">
                      <td class="px-4 py-3">
                        <%= radio_button_tag "guest_name_key", c.normalized_name, false, id: "guest_link_candidate_#{i}", disabled: !c.selectable?, "aria-label": c.guest_names.join(" / ") %>
                      </td>
                      <td class="px-4 py-3">
                        <label for="guest_link_candidate_<%= i %>" class="cursor-pointer">
                          <%= c.guest_names.join(" / ") %>
                          <% if !c.selectable? %>
                            <p class="text-xs text-red-700"><%= t("admin.users.guest_link.not_selectable") %></p>
                            <p class="text-xs text-red-700"><%= c.conflicts.join(" ") %></p>
                          <% end %>
                        </label>
                      </td>
                      <td class="px-4 py-3 text-sm">
                        <%= c.proxy_orders.first(3).map { |o| @events_by_id[o.event_id]&.title }.compact.join("、") %><% if c.proxy_orders.size > 3 %><%= t("admin.users.guest_link.more_orders", count: c.proxy_orders.size - 3) %><% end %>
                      </td>
                      <td class="px-4 py-3 text-sm">
                        <%= t("admin.users.guest_link.count_value", count: c.count) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <p class="hidden group-has-[:checked]:block text-sm text-stone-700 mt-4">
              <%= t("admin.users.guest_link.confirm_text", username: @user.username) %>
            </p>

            <!-- Footer -->
            <div class="px-6 py-4 border-t border-stone-200 flex justify-end gap-2 -mx-6 -mb-4">
              <button type="button" onclick="document.getElementById('guest_link_modal').innerHTML = ''" class="px-3 py-1.5 bg-white text-stone-800 border border-stone-300 rounded-md hover:bg-stone-50 font-bold text-xs">
                <%= t("admin.users.guest_link.cancel") %>
              </button>
              <%= submit_tag t("admin.users.guest_link.submit"), id: "guest_link_submit", disabled: true, class: "bg-indigo-700 text-white px-4 py-2 rounded hover:bg-indigo-800 font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>
